---
import "../global.css";

const { title = "Mimi Matematika" } = Astro.props;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <meta
            name="description"
            content="Mimi Matematika — belajar matematika dengan cara yang menyenangkan."
        />

        <title>{title}</title>

        <!-- Open Graph -->
        <meta property="og:title" content="Mimi Matematika" />
        <meta
            property="og:description"
            content="Mimi Matematika — belajar matematika dengan cara yang menyenangkan."
        />
        <meta
            property="og:image"
            content="https://mimimatematika.com/assets/card.sharing.png"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Mimi Matematika" />
        <meta property="og:url" content="https://mimimatematika.com/" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Mimi Matematika" />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Mimi Matematika" />
        <meta
            name="twitter:description"
            content="Mimi Matematika — belajar matematika dengan cara yang menyenangkan."
        />
        <meta
            name="twitter:image"
            content="https://mimimatematika.com/assets/card.sharing.png"
        />
        <meta name="twitter:image:alt" content="Mimi Matematika" />
    </head>

    <body>
        <slot />
    </body>
</html>