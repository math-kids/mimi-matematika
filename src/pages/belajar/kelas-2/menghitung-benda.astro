        const rect = groupingTwoPond.getBoundingClientRect();
        const x = Math.max(
            48,
            Math.min(
                rect.width - 48,
                clientX - rect.left - groupingTwoPointerOffsetX,
            ),
        );
        const y = Math.max(
            55,
            Math.min(
                rect.height - 55,
                clientY - rect.top - groupingTwoPointerOffsetY,
            ),
        );

        groupingTwoNet.style.left = `${x}px`;
        groupingTwoNet.style.top = `${y}px`;
        groupingTwoNet.style.transform =
            "translate(-50%, -50%) rotate(-8deg)";
    }

    groupingTwoNet.addEventListener("pointerdown", (event) => {
        if (!groupingTwoActive || groupingTwoRemaining <= 0) return;

        groupingTwoNetDragging = true;
        groupingTwoNet.setPointerCapture(event.pointerId);

        const netRect = groupingTwoNet.getBoundingClientRect();
        groupingTwoPointerOffsetX =
            event.clientX - (netRect.left + netRect.width / 2);
        groupingTwoPointerOffsetY =
            event.clientY - (netRect.top + netRect.height / 2);

        groupingTwoNet.classList.add("dragging");
    });

    groupingTwoNet.addEventListener("pointermove", (event) => {
        if (!groupingTwoNetDragging) return;
        updateGroupingTwoNetPosition(event.clientX, event.clientY);
    });

    groupingTwoNet.addEventListener("pointerup", () => {
        if (!groupingTwoNetDragging) return;

        groupingTwoNetDragging = false;
        groupingTwoNet.classList.remove("dragging");

        if (groupingTwoNetIsOverPond()) {
            scoopGroupingTwoKepik();
        } else {
            resetGroupingTwoNetPosition();
        }
    });

    groupingTwoNet.addEventListener("keydown", (event) => {
        if (
            (event.key === "Enter" || event.key === " ") &&
            groupingTwoActive
        ) {
            event.preventDefault();
            scoopGroupingTwoKepik();
        }
    });



    /* ========================================

       SETTINGS

    ======================================== */

    // Sementara 1 untuk testing.

    // Setelah game stabil → ubah menjadi 10.


    /* ========================================

       01D · GROUPING 5

    ======================================== */

    const groupingFiveContent =
        document.getElementById("grouping-five-content") as HTMLDivElement;

    const groupingFivePond =
        document.getElementById("grouping-five-pond-area") as HTMLDivElement;

    const groupingFiveFrogLayer =
        document.getElementById("grouping-five-frog-layer") as HTMLDivElement;

    const groupingFiveNet =
        document.getElementById("grouping-five-net") as HTMLDivElement;

    const groupingFiveGroups =
        document.getElementById("grouping-five-groups") as HTMLDivElement;

    const groupingFiveQuestion =
        document.getElementById("grouping-five-question") as HTMLDivElement;

    const groupingFiveAnswers =
        document.getElementById("grouping-five-answers") as HTMLDivElement;

    const groupingFiveMimiMessage =
        document.getElementById("grouping-five-mimi-message") as HTMLDivElement;

    const groupingFiveScoopEffect =
        document.getElementById("grouping-five-scoop-effect") as HTMLDivElement;

    let groupingFiveActive = false;
    let groupingFiveTotal = 0;
    let groupingFiveRemaining = 0;
    let groupingFiveCount = 0;
    let groupingFiveQuestionNumber = 0;
    let groupingFiveAnswering = false;
    let groupingFiveCorrectGroups = 0;
    let groupingFiveCorrectRemaining = 0;

    let groupingFiveNetDragging = false;
    let groupingFivePointerOffsetX = 0;
    let groupingFivePointerOffsetY = 0;

    const groupingFiveTotals = [
        10,
        12,
        15,
        17,
        20,
        23,
        25,
        26,
        30,
    ];

    function setGroupingFiveMessage(message: string, wrong = false) {
        groupingFiveMimiMessage.classList.toggle("wrong-message", wrong);
        groupingFiveMimiMessage.innerHTML = `
            <strong>Mimi</strong>
            <p>${message}</p>
        `;
    }

    function randomGroupingFiveTotal() {
        return groupingFiveTotals[
            Math.floor(Math.random() * groupingFiveTotals.length)
        ];
    }

    function resetGroupingFiveNetPosition() {
        groupingFiveNet.style.left = "50%";
        groupingFiveNet.style.top = "50%";
        groupingFiveNet.style.transform =
            "translate(-50%, -50%) rotate(-8deg)";
    }

    function renderGroupingFiveFrogs() {
        groupingFiveFrogLayer.innerHTML = "";

        const count = Math.min(groupingFiveRemaining, 30);
        const cells = Array.from({ length: 30 }, (_, index) => index);

        for (let i = cells.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [cells[i], cells[j]] = [cells[j], cells[i]];
        }

        for (let i = 0; i < count; i++) {
            const cell = cells[i];
            const column = (cell % 6) + 1;
            const row = Math.floor(cell / 6) + 1;

            const frog = document.createElement("img");
            frog.className = "grouping-five-frog";
            frog.src = "/assets/kodok.png";
            frog.alt = "Kodok";
            frog.draggable = false;
            frog.style.gridColumn = String(column);
            frog.style.gridRow = String(row);
            frog.style.scale = "0.5";
            frog.style.setProperty(
                "--frog-tilt",
                Math.random() > 0.5 ? "4deg" : "-4deg",
            );
            frog.style.setProperty(
                "--frog-delay",
                `${-(Math.random() * 1.7).toFixed(2)}s`,
            );
            groupingFiveFrogLayer.appendChild(frog);
        }
    }

    function renderGroupingFiveGroups(remainder = 0) {
        groupingFiveGroups.innerHTML = "";

        for (let slot = 0; slot < 6; slot++) {
            const group = document.createElement("div");
            group.className = "grouping-five-package";

            if (slot < groupingFiveCount) {
                const bundledFrog = document.createElement("img");
                bundledFrog.className = "group-frog";
                bundledFrog.src = "/assets/kodok-kotak.png";
                bundledFrog.alt = "5 kodok";
                bundledFrog.draggable = false;
                group.appendChild(bundledFrog);
            }

            if (slot === groupingFiveCount && remainder > 0) {
                group.className = `grouping-five-remainder remainder-count-${remainder}`;

                for (let i = 0; i < remainder; i++) {
                    const remainderFrog = document.createElement("img");
                    remainderFrog.className = "remainder-frog";
                    remainderFrog.src = "/assets/kodok.png";
                    remainderFrog.alt = "Kodok tersisa";
                    remainderFrog.draggable = false;
                    group.appendChild(remainderFrog);
                }
            }

            groupingFiveGroups.appendChild(group);
        }
    }

    function prepareGroupingFiveQuestion() {
        groupingFiveQuestion.classList.remove("hidden");
        groupingFiveAnswers.innerHTML = "";
        groupingFiveAnswering = false;

        const groups = groupingFiveCorrectGroups;
        const remainder = groupingFiveCorrectRemaining;
        const correctTotal = groups * 5 + remainder;

        let summaryHtml = `
            <strong>Mimi</strong>
            <p class="grouping-summary">
                Hore! Kamu berhasil menjaring ${groups} kelompok 5 kodok${
                    remainder > 0 ? ` dan ${remainder} kodok` : ""
                } 🎉
            </p>
        `;

        groupingFiveMimiMessage.innerHTML = summaryHtml;
        groupingFiveQuestion.before(
            document.getElementById("grouping-five-mimi")!,
        );

        const questionElement =
            groupingFiveQuestion.querySelector("p") as HTMLParagraphElement;
        questionElement.textContent = "Berapa total jumlah kodok?";

        const choices = [correctTotal];
        const distractors = [
            groups * 5,
            remainder,
            correctTotal + 5,
            correctTotal - 5,
            correctTotal + 1,
            correctTotal - 1,
        ];

        for (const value of distractors) {
            if (
                value > 0 &&
                value !== correctTotal &&
                !choices.includes(value)
            ) {
                choices.push(value);
            }
            if (choices.length >= 4) break;
        }

        while (choices.length < 4) {
            const value =
                Math.floor(Math.random() * Math.max(correctTotal + 10, 15)) + 1;
            if (!choices.includes(value)) choices.push(value);
        }

        choices.sort(() => Math.random() - 0.5);

        choices.forEach((choice) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "grouping-answer";
            button.textContent = String(choice);
            button.addEventListener("click", () =>
                checkGroupingFiveAnswer(choice),
            );
            groupingFiveAnswers.appendChild(button);
        });
    }

    function finishGroupingFiveQuestion() {
        groupingFiveQuestion.classList.add("hidden");
        groupingFiveCount = 0;
        groupingFiveRemaining = 0;
        groupingFiveActive = false;
        resetGroupingFiveNetPosition();

        if (groupingFiveQuestionNumber >= totalQuestions) {
            window.location.href =
                `/hasil-latihan?kelas=2&latihan=menghitung-benda&skor=${score}`;
            return;
        }

        startGroupingFiveQuestion();
    }

    function launchGroupingFiveConfetti() {
        const container = document.createElement("div");
        container.style.position = "fixed";
        container.style.left = "0";
        container.style.top = "0";
        container.style.width = "100vw";
        container.style.height = "100vh";
        container.style.pointerEvents = "none";
        container.style.overflow = "hidden";
        container.style.zIndex = "999999";
        document.body.appendChild(container);

        const colors = [
            "#7FAF8B",
            "#E8B86D",
            "#D98282",
            "#8FA8C7",
            "#C99A6B",
            "#F3C6C6",
            "#A8D8B9",
        ];

        for (let i = 0; i < 100; i++) {
            const piece = document.createElement("div");
            const size = 8 + Math.random() * 7;
            piece.style.position = "absolute";
            piece.style.width = `${size}px`;
            piece.style.height = `${size * 1.5}px`;
            piece.style.backgroundColor =
                colors[Math.floor(Math.random() * colors.length)];
            piece.style.left = `${Math.random() * 100}vw`;
            piece.style.top = "-30px";
            piece.style.borderRadius = "3px";
            container.appendChild(piece);

            const x = (Math.random() - 0.5) * 300;
            const y = 500 + Math.random() * 400;
            const rotation = 360 + Math.random() * 720;

            piece.animate(
                [
                    {
                        transform: "translate3d(0, 0, 0) rotate(0deg)",
                        opacity: 1,
                    },
                    {
                        transform: `translate3d(${x}px, ${y}px, 0) rotate(${rotation}deg)`,
                        opacity: 0,
                    },
                ],
                {
                    duration: 1800 + Math.random() * 1000,
                    delay: Math.random() * 200,
                    easing: "cubic-bezier(.2,.8,.3,1)",
                    fill: "forwards",
                },
            );
        }

        setTimeout(() => container.remove(), 3500);
    }

    function checkGroupingFiveAnswer(answer: number) {
        if (groupingFiveAnswering) return;

        groupingFiveAnswering = true;

        const correctTotal =
            groupingFiveCorrectGroups * 5 + groupingFiveCorrectRemaining;

        if (answer === correctTotal) {
            score += 10;
            scoreElement.textContent = String(score);
            setGroupingFiveMessage(
                "Hebat! Kamu berhasil menghitung semua kodok! 🎉",
            );
            launchGroupingFiveConfetti();
            setTimeout(finishGroupingFiveQuestion, 700);
        } else {
            groupingFiveAnswering = false;
            setGroupingFiveMessage(
                "Belum tepat. Coba hitung semua kodoknya lagi! 💪",
                true,
            );
        }
    }

    function scoopGroupingFiveFrogs() {
        if (
            !groupingFiveActive ||
            groupingFiveRemaining <= 0 ||
            groupingFiveAnswering
        ) {
            return;
        }

        const scoopCount = Math.min(5, groupingFiveRemaining);
        const frogs = Array.from(
            groupingFiveFrogLayer.querySelectorAll(".grouping-five-frog"),
        );

        frogs.slice(0, scoopCount).forEach((frogElement, index) => {
            setTimeout(
                () => frogElement.classList.add("caught"),
                index * 22,
            );
        });

        groupingFiveRemaining -= scoopCount;

        if (scoopCount === 5) groupingFiveCount += 1;

        groupingFiveScoopEffect.classList.remove("hidden");
        void groupingFiveScoopEffect.offsetWidth;
        groupingFiveScoopEffect.classList.add("hidden");

        setTimeout(() => {
            renderGroupingFiveFrogs();

            const remainder =
                groupingFiveRemaining === 0 && scoopCount < 5
                    ? scoopCount
                    : 0;

            renderGroupingFiveGroups(remainder);

            if (groupingFiveRemaining === 0) {
                groupingFiveActive = false;
                groupingFiveNet.style.cursor = "default";
                prepareGroupingFiveQuestion();
            } else {
                setGroupingFiveMessage(
                    "Bagus! Satu kelompok lagi berisi 5 kodok. 🐸",
                );
            }
        }, 350);
    }

    function groupingFiveNetIsOverPond() {
        const netRect = groupingFiveNet.getBoundingClientRect();
        const pondRect = groupingFivePond.getBoundingClientRect();
        const cx = netRect.left + netRect.width / 2;
        const cy = netRect.top + netRect.height / 2;

        return (
            cx >= pondRect.left + 15 &&
            cx <= pondRect.right - 15 &&
            cy >= pondRect.top + 15 &&
            cy <= pondRect.bottom - 15
        );
    }

    function startGroupingFiveQuestion() {
        groupingFiveQuestionNumber++;
        progressElement.textContent =
            `Soal ${groupingFiveQuestionNumber} / ${totalQuestions}`;

        groupingFiveTotal = randomGroupingFiveTotal();
        groupingFiveRemaining = groupingFiveTotal;
        groupingFiveCount = 0;
        groupingFiveCorrectGroups = Math.floor(groupingFiveTotal / 5);
        groupingFiveCorrectRemaining = groupingFiveTotal % 5;
        groupingFiveActive = true;
        groupingFiveAnswering = false;
        groupingFiveQuestion.classList.add("hidden");
        groupingFiveNet.style.cursor = "grab";
        resetGroupingFiveNetPosition();
        renderGroupingFiveFrogs();
        groupingFiveGroups.innerHTML = "";

        setGroupingFiveMessage(
            "Ayo jaring kodok! Sekali menjaring, dapat 5 kodok. Jika tersisa, jaring semuanya. 🐸",
        );
    }

    function activateGroupingFiveMode() {
        groupingFiveQuestionNumber = 0;
        startGroupingFiveQuestion();
    }

    function updateGroupingFiveNetPosition(
        clientX: number,
        clientY: number,
    ) {
        const rect = groupingFivePond.getBoundingClientRect();
        const x = Math.max(48, Math.min(
            rect.width - 48,
            clientX - rect.left - groupingFivePointerOffsetX,
        ));
        const y = Math.max(55, Math.min(
            rect.height - 55,
            clientY - rect.top - groupingFivePointerOffsetY,
        ));

        groupingFiveNet.style.left = `${x}px`;
        groupingFiveNet.style.top = `${y}px`;
        groupingFiveNet.style.transform =
            "translate(-50%, -50%) rotate(-8deg)";
    }

    groupingFiveNet.addEventListener("pointerdown", (event) => {
        if (!groupingFiveActive || groupingFiveRemaining <= 0) return;

        groupingFiveNetDragging = true;
        groupingFiveNet.setPointerCapture(event.pointerId);

        const netRect = groupingFiveNet.getBoundingClientRect();
        groupingFivePointerOffsetX =
            event.clientX - (netRect.left + netRect.width / 2);
        groupingFivePointerOffsetY =
            event.clientY - (netRect.top + netRect.height / 2);

        groupingFiveNet.classList.add("dragging");
    });

    groupingFiveNet.addEventListener("pointermove", (event) => {
        if (!groupingFiveNetDragging) return;
        updateGroupingFiveNetPosition(event.clientX, event.clientY);
    });

    groupingFiveNet.addEventListener("pointerup", () => {
        if (!groupingFiveNetDragging) return;

        groupingFiveNetDragging = false;
        groupingFiveNet.classList.remove("dragging");

        if (groupingFiveNetIsOverPond()) {
            scoopGroupingFiveFrogs();
        } else {
            resetGroupingFiveNetPosition();
        }
    });

    groupingFiveNet.addEventListener("keydown", (event) => {
        if (
            (event.key === "Enter" || event.key === " ") &&
            groupingFiveActive
        ) {
            event.preventDefault();
            scoopGroupingFiveFrogs();
        }
    });


    /* ========================================

       SUB LATIHAN

    ======================================== */

    function switchSubexercise(subexercise: string) {

        subexerciseButtons.forEach((button) => {
            const isActive =
                (button as HTMLButtonElement).dataset.subexercise === subexercise;

            button.classList.toggle("active", isActive);
            button.setAttribute("aria-selected", String(isActive));
        });

        if (subexercise === "01B") {
            subexercise01A.forEach((element) =>
                element.classList.add("hidden"),
            );

            groupingContent.classList.remove("hidden");
            groupingTwoContent.classList.add("hidden");
            groupingFiveContent.classList.add("hidden");

            exerciseTitle.textContent =
                "Menghitung dengan Mengelompokkan 10";
            exerciseDescription.textContent =
                "Jaring ikan menjadi kelompok 10.";

            activateGroupingMode();
        } else if (subexercise === "01C") {
            subexercise01A.forEach((element) =>
                element.classList.add("hidden"),
            );

            groupingContent.classList.add("hidden");
            groupingTwoContent.classList.remove("hidden");
            groupingFiveContent.classList.add("hidden");

            exerciseTitle.textContent =
                "Menghitung dengan Mengelompokkan 2";
            exerciseDescription.textContent =
                "Jaring kepik menjadi kelompok 2.";

            activateGroupingTwoMode();
        } else if (subexercise === "01D") {
            subexercise01A.forEach((element) =>
                element.classList.add("hidden"),
            );

            groupingContent.classList.add("hidden");
            groupingTwoContent.classList.add("hidden");
            groupingFiveContent.classList.remove("hidden");

            exerciseTitle.textContent =
                "Menghitung dengan Mengelompokkan 5";
            exerciseDescription.textContent =
                "Jaring kodok menjadi kelompok 5.";

            activateGroupingFiveMode();
        } else {
            groupingContent.classList.add("hidden");
            groupingTwoContent.classList.add("hidden");
            groupingFiveContent.classList.add("hidden");

            subexercise01A.forEach((element) =>
                element.classList.remove("hidden"),
            );

            exerciseTitle.textContent = "Menghitung Benda di Alam";
            exerciseDescription.textContent =
                "Hitung jumlah benda yang ada di gambar.";
        }
    }

    subexerciseButtons.forEach((button) => {

        button.addEventListener("click", () => {

            const subexercise =

                (button as HTMLButtonElement).dataset.subexercise || "01A";

            switchSubexercise(subexercise);

        });

    });

    /* ========================================

       MIMI MESSAGE

    ======================================== */

    function setMimiMessage(message: string) {

        mimiMessage.classList.remove("wrong-message");

        mimiMessage.innerHTML = `

            <strong>Mimi</strong>

            <p>${message}</p>

        `;

    }

    function setWrongMessage(message: string) {

        mimiMessage.classList.add("wrong-message");

        mimiMessage.innerHTML = `

            <strong>Mimi</strong>

            <p>${message}</p>

        `;

    }

    /* ========================================

       GENERATE QUESTION

    ======================================== */

    function generateQuestion() {

        answering = false;

        questionNumber++;

        progressElement.textContent = `Soal ${questionNumber} / ${totalQuestions}`;

        const objects = ["🍎", "🌸", "🍃", "🪨", "🐚", "🌰"];

        const object = objects[Math.floor(Math.random() * objects.length)];

        const amount = Math.floor(Math.random() * 8) + 2;

        correctAnswer = amount;

        const objectHTML = Array.from(

            { length: amount },

            () => `<span class="counting-object">${object}</span>`,

        ).join("");

        questionElement.innerHTML = `

            <div class="counting-objects">

                ${objectHTML}

            </div>

        `;

        showNormalAnswers(correctAnswer);

    }

    /* ========================================

       ANSWERS

    ======================================== */

    function showNormalAnswers(answer: number) {

        const answers: number[] = [answer];

        while (answers.length < 4) {

            const wrongAnswer = answer + Math.floor(Math.random() * 7) - 3;

            if (wrongAnswer >= 0 && !answers.includes(wrongAnswer)) {

                answers.push(wrongAnswer);

            }

        }

        answers.sort(() => Math.random() - 0.5);

        answerButtons.forEach((button, index) => {

            const answerButton = button as HTMLButtonElement;

            answerButton.disabled = false;

            answerButton.textContent = String(answers[index]);

            answerButton.onclick = () => {

                checkAnswer(answers[index]);

            };

        });

    }

    /* ========================================

       CHECK ANSWER

    ======================================== */

    function checkAnswer(answer: number) {

        if (answering) {

            return;

        }

        if (answer === correctAnswer) {

            answering = true;

            score += 10;

            scoreElement.textContent = String(score);

            setMimiMessage("Hebat! Jawabanmu benar! 🎉");

            launchConfetti();

            mimiElement.classList.remove("wrong", "correct");

            void mimiElement.offsetWidth;

            mimiElement.classList.add("correct");

            answerButtons.forEach((button) => {

                (button as HTMLButtonElement).disabled = true;

            });

            setTimeout(nextQuestion, 800);

        } else {

            setWrongMessage("Belum tepat. Coba lagi! 💪");

            mimiElement.classList.remove("correct", "wrong");

            void mimiElement.offsetWidth;

            mimiElement.classList.add("wrong");

        }

    }

    /* ========================================

       NEXT QUESTION

    ======================================== */

    function nextQuestion() {

        mimiElement.classList.remove("correct", "wrong");

        if (questionNumber >= totalQuestions) {

            showResult();

        } else {

            setMimiMessage("Ayo hitung benda-bendanya! 🌿");

            generateQuestion();

        }

    }

    /* ========================================

       RESULT

    ======================================== */

    function showResult() {

    window.location.href =

    `/hasil-latihan?kelas=2&latihan=menghitung-benda&skor=${score}`;

}

    /* ========================================

       PLAY AGAIN

    ======================================== */

    playAgainButton.addEventListener("click", () => {

        score = 0;

        questionNumber = 0;

        correctAnswer = 0;

        answering = false;

        scoreElement.textContent = "0";

        resultScreen.classList.add("hidden");

        exerciseInfo.classList.remove("hidden");

        document.querySelector("#mimi-area")!.classList.remove("hidden");

        document.querySelector(".question-card")!.classList.remove("hidden");

        document.querySelector(".answers")!.classList.remove("hidden");

        setMimiMessage("Ayo hitung benda-bendanya! 🌿");

        generateQuestion();

    });

    /* ========================================

       START

    ======================================== */

    generateQuestion();

