---

import MainLayout from "../../../layouts/MainLayout.astro";

import Header from "../../../components/Header.astro";

---

<MainLayout title="Menghitung Benda di Alam — Mimi Matematika">

    <Header />

    <main class="game-page">

        <!-- TOP BAR -->

        <div class="game-topbar">

            <a href="/belajar/kelas-2" class="back-button"> ← Pilih latihan </a>

            <div class="game-class">Kelas 2 SD</div>

            <div class="game-score">

                ⭐ <span id="score">0</span>

            </div>

        </div>

        <!-- BANNER LATIHAN -->

        <section class="exercise-banner">

            <img

                src="/assets/banner-latihan.png"

                alt="Mimi belajar matematika"

            />

        </section>

        <!-- INFO LATIHAN -->

        <div class="exercise-info">

            <div>

                <span class="lesson-badge"> Latihan 01 </span>

                <h1>Menghitung Benda di Alam</h1>

                <p>Hitung jumlah benda yang ada di gambar.</p>

            </div>

            <div id="progress" class="progress">Soal 1 / 1</div>

        </div>

        <!-- SUB LATIHAN -->

        <div class="subexercise-selector" role="tablist" aria-label="Bagian latihan">

            <button

                type="button"

                class="subexercise-button active"

                data-subexercise="01A"

                role="tab"

                aria-selected="true"

            >

                01A · Menghitung Benda

            </button>

            <button

                type="button"

                class="subexercise-button"

                data-subexercise="01B"

                role="tab"

                aria-selected="false"

            >

                01B · Menghitung dengan Mengelompokkan 10

            </button>

            <button
                type="button"
                class="subexercise-button"
                data-subexercise="01C"
                role="tab"
                aria-selected="false"
            >
                01C · Menghitung dengan Mengelompokkan 2
            </button>
            <button
                type="button"
                class="subexercise-button"
                data-subexercise="01D"
                role="tab"
                aria-selected="false"
            >
                01D · Menghitung dengan Mengelompokkan 5
            </button>

        </div>





        <!-- 01B · MENGHITUNG DENGAN MENGELOMPOKKAN -->

        <section id="grouping-content" class="grouping-content hidden">

            <div class="grouping-instruction">

                <strong>🎣 Sekali menjaring, bisa dapat 10 ikan!</strong>

                <span>Jaring sampai semua ikan masuk ke tank kanan.</span>

            </div>

            <div class="grouping-game">

                <div class="pond-area" id="pond-area">

                    <div class="pond-water"></div>

                    <div id="fish-layer" class="fish-layer"></div>

                    <div id="net" class="fish-net" role="button" tabindex="0" aria-label="Jaring ikan">

                        <span class="net-hoop"></span>

                        <span class="net-handle"></span>

                    </div>

                    <div id="scoop-effect" class="scoop-effect hidden">✨</div>

                </div>

                <div class="grouping-result-area">

                    <div class="group-title">Kelompok ikan</div>

                    <div id="fish-groups" class="fish-groups"></div>

                </div>

            </div>

            <div id="grouping-question" class="grouping-question hidden">

                <p>Berapa kelompok 10 dan berapa ikan yang tersisa?</p>

                <div id="grouping-answers" class="grouping-answers"></div>

            </div>

            <div id="grouping-mimi" class="grouping-mimi">

                <img src="/assets/mimi.png" alt="Mimi" />

                <div id="grouping-mimi-message">

                    <strong>Mimi</strong>

                    <p>Ayo jaring ikan! 🎣</p>

                </div>

            </div>

        </section>

        <!-- 01C · MENGHITUNG DENGAN MENGELOMPOKKAN 2 -->

        <section id="grouping-two-content" class="grouping-content hidden">

            <div class="grouping-instruction">
                <strong>🐞 Sekali menjaring, dapat 2 kepik!</strong>
                <span>Jaring sampai semua kepik masuk ke kotak kanan.</span>
            </div>

            <div class="grouping-game">

                <div class="pond-area" id="grouping-two-pond-area">
                    <div class="pond-water"></div>
                    <div id="grouping-two-fish-layer" class="fish-layer"></div>

                    <div
                        id="grouping-two-net"
                        class="fish-net"
                        role="button"
                        tabindex="0"
                        aria-label="Jaring kepik"
                    >
                        <span class="net-hoop"></span>
                        <span class="net-handle"></span>
                    </div>

                    <div
                        id="grouping-two-scoop-effect"
                        class="scoop-effect hidden"
                    >✨</div>
                </div>

                <div class="grouping-result-area">
                    <div class="group-title">Kelompok kepik</div>
                    <div id="grouping-two-groups" class="fish-groups"></div>
                </div>

            </div>

            <div id="grouping-two-question" class="grouping-question hidden">
                <p>Berapa total jumlah kepik?</p>
                <div id="grouping-two-answers" class="grouping-answers"></div>
            </div>

            <div id="grouping-two-mimi" class="grouping-mimi">
                <img src="/assets/mimi.png" alt="Mimi" />
                <div id="grouping-two-mimi-message">
                    <strong>Mimi</strong>
                    <p>Ayo jaring kepik! 🐞</p>
                </div>
            </div>

        </section>

        <!-- 01D · MENGHITUNG DENGAN MENGELOMPOKKAN 5 -->

        <section id="grouping-five-content" class="grouping-content hidden">

            <div class="grouping-instruction">
                <strong>🐸 Sekali menjaring, dapat 5 kodok!</strong>
                <span>Jaring sampai tidak cukup untuk membuat kelompok 5 lagi.</span>
            </div>

            <div class="grouping-game">

                <div class="pond-area" id="grouping-five-pond-area">
                    <div class="pond-water"></div>
                    <div id="grouping-five-frog-layer" class="grouping-five-frog-layer"></div>

                    <div
                        id="grouping-five-net"
                        class="fish-net"
                        role="button"
                        tabindex="0"
                        aria-label="Jaring kodok"
                    >
                        <span class="net-hoop"></span>
                        <span class="net-handle"></span>
                    </div>

                    <div
                        id="grouping-five-scoop-effect"
                        class="scoop-effect hidden"
                    >✨</div>
                </div>

                <div class="grouping-result-area">
                    <div class="group-title">Kelompok kodok</div>
                    <div id="grouping-five-groups" class="grouping-five-groups"></div>
                </div>

            </div>

            <div id="grouping-five-question" class="grouping-question hidden">
                <p>Berapa total jumlah kodok?</p>
                <div id="grouping-five-answers" class="grouping-answers"></div>
            </div>

            <div id="grouping-five-mimi" class="grouping-mimi">
                <img src="/assets/mimi.png" alt="Mimi" />
                <div id="grouping-five-mimi-message">
                    <strong>Mimi</strong>
                    <p>Ayo jaring kodok! 🐸</p>
                </div>
            </div>

        </section>

        <!-- MIMI -->

        <section id="mimi-area" class="subexercise-01a">

            <div id="mimi">

                <img id="mimi-image" src="/assets/mimi.png" alt="Mimi" />

            </div>

            <div id="mimi-message" class="mimi-message">

                <strong>Mimi</strong>

                <p>Ayo hitung benda-bendanya! 🌿</p>

            </div>

        </section>

        <!-- SOAL -->

        <section class="question-card subexercise-01a">

            <div class="question-box">

                <div id="question">🌿 🌿 🌿</div>

            </div>

        </section>

        <!-- JAWABAN -->

        <section class="answers subexercise-01a">

            <button type="button"></button>

            <button type="button"></button>

            <button type="button"></button>

            <button type="button"></button>

        </section>

        <!-- HASIL -->

        <section id="result-screen" class="result-screen hidden">

            <div class="result-icon">🎉</div>

            <span class="lesson-badge"> Latihan 01 </span>

            <h1>Hebat!</h1>

            <p>Latihanmu sudah selesai.</p>

            <div class="result-score">

                <span> Skor kamu </span>

                <strong id="final-score"> 0 </strong>

            </div>

            <div class="result-actions">

                <button id="play-again" type="button"> Coba Lagi </button>

                <a href="/permainan" class="choose-game"> 🎁 Pilih Games </a>

                <a href="/belajar/kelas-2" class="back-to-lessons">

                    Pilih Latihan

                </a>

            </div>

        </section>

    </main>

    <!-- FOOTER -->

    <footer class="site-footer">

        <div class="footer-inner">

            <div class="footer-brand">

                <img src="/assets/mimi.png" alt="Mimi Matematika" />

                <div>

                    <strong> Mimi Matematika </strong>

                    <span> Langkah kecil hari ini, prestasi besar nanti. </span>

                </div>

            </div>

            <div class="footer-links">

                <a href="/belajar"> Belajar </a>

                <a href="/ngobrol"> Mimi Ngobrol </a>

                <a href="/permainan"> Permainan </a>

            </div>

        </div>

        <div class="footer-bottom">© 2026 Mimi Matematika</div>

    </footer>

</MainLayout>

<style>

    /* ========================================

   GAME PAGE

======================================== */

    .game-page {

        width: 100%;

        max-width: 1180px;

        margin: 0 auto;

        padding: 0 24px 12px;

        background: #f3faf5;

    }

    /* ========================================

   TOP BAR

======================================== */

    .game-topbar {

        display: grid;

        grid-template-columns: 1fr auto 1fr;

        align-items: center;

        margin-bottom: 0;

    }

    .back-button {

        justify-self: start;

        color: #39704b;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;

    }

    .back-button:hover {

        text-decoration: underline;

    }

    .game-class {

        color: #587264;

        font-size: 13px;

        font-weight: 700;

    }

    .game-score {

        justify-self: end;

        padding: 7px 13px;

        background: #fff4d7;

        border-radius: 16px;

        color: #7b6840;

        font-size: 13px;

        font-weight: 700;

    }

    /* ========================================

   BANNER

======================================== */

    .exercise-banner {

        width: 100%;

        overflow: hidden;

        margin: 0;

        line-height: 0;

        max-height: 300px;

    }

    .exercise-banner img {

        display: block;

        width: 100%;

        height: auto;

        max-width: 100%;

        margin-top: -55px;

        margin-bottom: -55px;

    }

    /* ========================================

   INFO LATIHAN

======================================== */

    .exercise-info {

        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 0;

    }

    .lesson-badge {

        display: inline-block;

        padding: 5px 10px;

        background: #dff3e5;

        color: #39704b;

        border-radius: 20px;

        font-size: 10px;

        font-weight: 700;

    }

    .exercise-info h1 {

        margin: 0;

        color: #173f4b;

        font-size: 25px;

        line-height: 1.15;

    }

    .exercise-info p {

        margin: 0;

        color: #718078;

        font-size: 12px;

    }

    .progress {

        flex-shrink: 0;

        color: #8b918b;

        font-size: 12px;

        font-weight: 600;

    }

    /* ========================================

       SUB LATIHAN

    ======================================== */

    .subexercise-selector {

        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 5px;

        margin: 0 0 8px;

    }

    .subexercise-button {

        min-height: 36px;

        padding: 6px 10px;

        border: none;

        border-radius: 12px;

        background: #edf3ee;

        color: #45604e;

        font-size: 11px;

        font-weight: 700;

        cursor: pointer;

        transition:

            **background** 0.15s ease,

            transform 0.15s ease;

    }

    .subexercise-button:hover {

        background: #e1ebe2;

        transform: translateY(-1px);

    }

    .subexercise-button.active {

        background: #dbe8d9;

        color: #39704b;

    }

    .grouping-content {

        margin-bottom: 8px;

    }

    .grouping-placeholder {

        min-height: 180px;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        padding: 24px;

        background: #f8f3e9;

        border-radius: 20px;

        text-align: center;

    }

    .grouping-placeholder h2 {

        margin: 10px 0 5px;

        color: #173f4b;

        font-size: 24px;

    }

    .grouping-placeholder p {

        max-width: 520px;

        margin: 0;

        color: #718078;

        font-size: 13px;

        line-height: 1.5;

    }

    /* ========================================

   MIMI

======================================== */

    #mimi-area {

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 10px;

        min-height: 52px;

        margin: 0 0 3px;

    }

    #mimi {

        flex-shrink: 0;

    }

    #mimi-image {

        display: block;

        width: 50px;

        height: 50px;

        object-fit: contain;

    }

    .mimi-message {

        min-width: 190px;

        padding: 8px 14px;

        background: #edf3eb;

        border-radius: 16px;

        color: #526258;

    }

    .mimi-message strong {

        display: block;

        margin-bottom: 2px;

        color: #6d8a78;

        font-size: 12px;

    }

    .mimi-message p {

        margin: 0;

        font-size: 13px;

    }

    .mimi-message.wrong-message {

        background: #f8d7d7;

        color: #8f3f3f;

    }

    .mimi-message.wrong-message strong {

        color: #a94b4b;

    }

    /* ========================================

   MIMI ANIMATION

======================================== */

    #mimi.correct {

        animation: mimiJump 0.7s ease;

    }

    #mimi.wrong {

        animation: mimiShake 0.45s ease;

    }

    @keyframes mimiJump {

        0% {

            transform: translateY(0);

        }

        40% {

            transform: translateY(-10px);

        }

        70% {

            transform: translateY(-4px);

        }

        100% {

            transform: translateY(0);

        }

    }

    @keyframes mimiShake {

        0%,

        100% {

            transform: translateX(0);

        }

        25% {

            transform: translateX(-5px);

        }

        75% {

            transform: translateX(5px);

        }

    }

    /* ========================================

   QUESTION

======================================== */

    .question-card {

        background: #f8f3e9;

        border-radius: 20px;

        padding: 12px;

        margin-bottom: 8px;

    }

    .question-instruction {

        margin: 0 0 7px;

        text-align: center;

        color: #7c837c;

        font-size: 12px;

    }

    .question-box {

        min-height: 135px;

        display: flex;

        align-items: center;

        justify-content: center;

        padding: 12px;

        background: #fffdf9;

        border-radius: 17px;

        overflow: hidden;

    }

    #question {

        width: 100%;

        color: #29372f;

        text-align: center;

        font-size: 38px;

        font-weight: 700;

        line-height: 1.25;

    }

    /* ========================================

   COUNTING OBJECTS

======================================== */

    .counting-objects {

        display: flex;

        flex-wrap: wrap;

        align-items: center;

        justify-content: center;

        gap: 8px;

        max-width: 800px;

        margin: 0 auto;

    }

    .counting-object {

        font-size: 40px;

        line-height: 1;

    }

    /* ========================================

   ANSWERS

======================================== */

    .answers {

        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 8px;

        width: 100%;

    }

    .answers button {

        width: 100%;

        min-height: 50px;

        border: none;

        border-radius: 14px;

        background: #edf3ee;

        color: #263f35;

        font-size: 21px;

        font-weight: 700;

        cursor: pointer;

        transition:

            transform 0.15s,

            box-shadow 0.15s,

            **background** 0.15s;

    }

    .answers button:hover {

        background: #e1ebe2;

        transform: translateY(-2px);

        box-shadow: 0 5px 14px rgba(50, 70, 55, 0.08);

    }

    .answers button:active {

        transform: scale(0.97);

    }

    .answers button:disabled {

        cursor: default;

    }

    /* ========================================

   RESULT

======================================== */

    .result-screen {

        padding: 40px 20px;

        text-align: center;

    }

    .result-icon {

        margin-bottom: 10px;

        font-size: 52px;

    }

    .result-screen h1 {

        margin: 12px 0 5px;

        color: #173f4b;

        font-size: 34px;

    }

    .result-screen > p {

        margin: 0;

        color: #718078;

        font-size: 14px;

    }

    .result-score {

        display: flex;

        flex-direction: column;

        gap: 4px;

        margin: 18px 0;

        color: #718078;

        font-size: 14px;

    }

    .result-score strong {

        color: #39704b;

        font-size: 30px;

    }

    .result-actions {

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 10px;

    }

    #play-again,

    .back-to-lessons {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        min-height: 42px;

        padding: 0 20px;

        border-radius: 14px;

        font-size: 13px;

        font-weight: 700;

        text-decoration: none;

        cursor: pointer;

    }

    .choose-game {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        min-height: 44px;

        padding: 0 20px;

        border-radius: 14px;

        background: #f3d9a5;

        color: #5b4636;

        font-size: 13px;

        font-weight: 700;

        text-decoration: none;

        cursor: pointer;

        transition: transform 0.15s ease;

    }

    .choose-game:hover {

        transform: translateY(-2px);

    }

    #play-again {

        border: none;

        background: #dbe8d9;

        color: #45604e;

    }

    .back-to-lessons {

        background: #edf3ee;

        color: #45604e;

    }

    /* ========================================

   FOOTER

======================================== */

    .site-footer {

        width: 100%;

        max-width: 1180px;

        margin: 0 auto;

        background: #e8f6ec;

    }

    .footer-inner {

        width: 100%;

        min-height: 64px;

        padding: 12px 24px;

        display: flex;

        align-items: center;

        justify-content: space-between;

    }

    .footer-brand {

        display: flex;

        align-items: center;

        gap: 8px;

    }

    .footer-brand img {

        width: 32px;

        height: 32px;

        object-fit: contain;

    }

    .footer-brand > div {

        display: flex;

        flex-direction: column;

        gap: 2px;

    }

    .footer-brand strong {

        color: #244b38;

        font-size: 13px;

        line-height: 1.1;

    }

    .footer-brand span {

        color: #708279;

        font-size: 10px;

        line-height: 1.2;

    }

    .footer-links {

        display: flex;

        align-items: center;

        gap: 18px;

    }

    .footer-links a {

        color: #39704b;

        font-size: 11px;

        font-weight: 600;

        text-decoration: none;

    }

    .footer-links a:hover {

        text-decoration: underline;

    }

    .footer-bottom {

        padding: 7px 24px 9px;

        text-align: center;

        color: #8a9990;

        font-size: 9px;

        border-top: 1px solid rgba(80, 120, 90, 0.06);

    }

    /* ========================================

       01B · GROUPING GAME

    ======================================== */

    .grouping-content {

        margin-bottom: 8px;

    }

    .grouping-instruction {

        display: flex;

        align-items: center;

        justify-content: center;

        flex-direction: column;

        gap: 2px;

        margin-bottom: 7px;

        text-align: center;

    }

    .grouping-instruction strong {

        color: #39704b;

        font-size: 14px;

    }

    .grouping-instruction span {

        color: #718078;

        font-size: 11px;

    }

    .grouping-game {

        display: grid;

        grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);

        gap: 8px;

    }

    .pond-area {

        position: relative;

        min-height: 310px;

        overflow: hidden;

        border-radius: 22px;

        background: #d8eee5;

        box-shadow: inset 0 0 0 4px rgba(255,255,255,.35);

        touch-action: none;

    }

    .pond-water {

        position: absolute;

        inset: 0;

        background:

            radial-gradient(circle at 20% 25%, rgba(255,255,255,.34) 0 3px, transparent 4px),

            radial-gradient(circle at 75% 68%, rgba(255,255,255,.25) 0 4px, transparent 5px),

            linear-gradient(145deg, #c9e9df, #b9ddd8);

    }

    .pond-water::after {

        content: "";

        position: absolute;

        inset: 14px;

        border: 1px dashed rgba(71,133,126,.18);

        border-radius: 18px;

        pointer-events: none;

    }

    .fish-layer {

        position: absolute;

        inset: 14px;

        display: grid;

        grid-template-columns: repeat(8, 1fr);

        grid-template-rows: repeat(4, 1fr);

        align-items: center;

        justify-items: center;

        border-radius: 14px;

        overflow: hidden;

    }

    .pond-fish {

        position: relative;

        width: 58%;

        height: 58%;

        object-fit: contain;

        display: block;

        user-select: none;

        pointer-events: none;

        animation: fishSwim 1.7s ease-in-out infinite;

        animation-delay: var(--fish-delay, 0s);

    }

    @keyframes fishSwim {

        0%, 100% {

            transform: translateX(0) rotate(var(--fish-tilt, 0deg)) scaleX(var(--fish-direction, 1));

        }

        25% {

            transform: translateX(2px) rotate(calc(var(--fish-tilt, 0deg) + 2deg)) scaleX(var(--fish-direction, 1));

        }

        50% {

            transform: translateX(0) rotate(var(--fish-tilt, 0deg)) scaleX(var(--fish-direction, 1));

        }

        75% {

            transform: translateX(-2px) rotate(calc(var(--fish-tilt, 0deg) - 2deg)) scaleX(var(--fish-direction, 1));

        }

    }

    .pond-fish.caught {

        animation: none;

        opacity: 0;

        transform: scale(var(--fish-direction, 1)) scale(.35) translateY(-18px);

    }

    .pond-fish.facing-left {

        --fish-direction: -1;

    }

    .fish-net {

        position: absolute;

        left: 50%;

        top: 50%;

        width: 134px;

        height: 175px;

        z-index: 5;

        cursor: grab;

        transform: translate(-50%, -50%) rotate(-8deg);

        touch-action: none;

        user-select: none;

        filter: drop-shadow(0 5px 5px rgba(50,80,70,.16));

    }

    .fish-net:active,

    .fish-net.dragging {

        cursor: grabbing;

    }

    .net-hoop {

        position: absolute;

        left: 12px;

        top: 6px;

        width: 98px;

        height: 98px;

        border: 7px solid #8a6b4e;

        border-radius: 50%;

        background:

            repeating-linear-gradient(45deg, transparent 0 7px, rgba(115,145,137,.38) 8px 9px),

            repeating-linear-gradient(-45deg, transparent 0 7px, rgba(115,145,137,.38) 8px 9px),

            rgba(225,245,239,.25);

    }

    .net-handle {

        position: absolute;

        width: 16px;

        height: 86px;

        left: 62px;

        top: 93px;

        border-radius: 8px;

        background: #8a6b4e;

        transform: rotate(-5deg);

        transform-origin: top center;

    }

    .scoop-effect {

        position: absolute;

        z-index: 8;

        left: 50%;

        top: 50%;

        transform: translate(-50%, -50%);

        font-size: 35px;

        pointer-events: none;

        animation: scoopPop .65s ease forwards;

    }

    @keyframes scoopPop {

        0% { opacity: 0; transform: translate(-50%, -50%) scale(.4); }

        35% { opacity: 1; transform: translate(-50%, -60%) scale(1.15); }

        100% { opacity: 0; transform: translate(-50%, -90%) scale(1); }

    }

    .grouping-result-area {

        min-height: 310px;

        padding: 10px;

        border-radius: 22px;

        background: #f8f3e9;

        box-sizing: border-box;

        overflow: hidden;

    }

    .group-title {

        margin-bottom: 8px;

        color: #587264;

        font-size: 12px;

        font-weight: 700;

        text-align: center;

    }

    .fish-groups {

        display: grid;

        grid-template-columns: repeat(2, minmax(0, 1fr));

        grid-template-rows: repeat(2, minmax(0, 1fr));

        gap: 0;

        height: 264px;

        margin: 0;

    }

    :global(.fish-group) {

        position: relative;

        width: 100%;

        min-width: 0;

        min-height: 0;

        margin: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 0;

        padding: 4px;

        box-sizing: border-box;

        border: none;

        border-radius: 14px 14px 18px 18px;

        background: transparent;

        box-shadow: none;

        animation: groupAppear .35s ease;

        overflow: hidden;

    }

    /* Bibir akuarium */

    :global(.fish-group)::before {

        display: none;

        content: "";

        position: absolute;

        left: 8px;

        right: 8px;

        top: 5px;

        height: 7px;

        border-radius: 50%;

        border-top: 2px solid rgba(255,255,255,.7);

        background: rgba(255,255,255,.18);

        z-index: 2;

        pointer-events: none;

    }

    /* Gelembung akuarium */

    :global(.fish-group)::after {

        display: none;

        content: "•••";

        position: absolute;

        right: 8px;

        top: 20px;

        color: rgba(255,255,255,.7);

        font-size: 9px;

        line-height: 1;

        letter-spacing: 2px;

        transform: rotate(-8deg);

        z-index: 2;

        pointer-events: none;

    }

    :global(.group-cell-grid) {

        position: absolute;

        inset: 10px;

        display: grid;

        grid-template-columns: repeat(3, minmax(0, 1fr));

        grid-template-rows: repeat(2, minmax(0, 1fr));

        border: none !important;

        border-radius: 0;

        overflow: hidden;

        z-index: 20 !important;

        pointer-events: none;

        box-sizing: border-box;

    }

    /* Grid kecil hanya disembunyikan secara visual; cell tetap menjadi container ikan. */

    :global(.group-cell-grid) {

        border: none !important;

        background: transparent !important;

    }

    :global(.group-cell) {

        min-width: 0;

        min-height: 0;

        display: grid;

        place-items: center;

        border: none !important;

        box-sizing: border-box;

    }

    :global(.group-cell:nth-child(3n)) {

        border-right: none !important;

    }

    :global(.group-cell:nth-child(n + 4)) {

        border-bottom: none !important;

    }

    :global(.fish-group .group-fish) {

        position: absolute;

        left: 50%;

        top: 50%;

        z-index: 3;

        width: 94%;

        height: 94%;

        max-width: 100%;

        max-height: 100%;

        object-fit: contain;

        display: block;

        transform: translate(-50%, -50%);

    }

    /* Ikan sisa ditempatkan LANGSUNG di cell kecil grid 2 × 5.

       Tidak ada grid tambahan/overlay. */

    :global(.remainder-fish) {

        width: 88%;

        height: 88%;

        max-width: 100%;

        max-height: 100%;

        object-fit: contain;

        display: block;

        position: relative;

        z-index: 3;

        animation: fishSwim 1.7s ease-in-out infinite;

        animation-delay: var(--fish-delay, 0s);

    }

    @keyframes groupAppear {

        from { opacity: 0; transform: scale(.92) translateY(5px); }

        to { opacity: 1; transform: scale(1) translateY(0); }

    }

    .grouping-question {

        position: relative;

        z-index: 20;

        pointer-events: auto;

        margin-top: 8px;

        padding: 10px;

        border-radius: 16px;

        background: #f8f3e9;

        text-align: center;

    }

    .grouping-question p {

        margin: 0 0 8px;

        color: #526258;

        font-size: 13px;

        font-weight: 700;

    }

    .grouping-answers {

        position: relative;

        z-index: 21;

        pointer-events: auto;

        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 7px;

    }

    .grouping-answer {

        position: relative;

        z-index: 22;

        pointer-events: auto;

        width: 100%;

        min-height: 50px;

        padding: 0 10px;

        border: none;

        border-radius: 14px;

        background: #edf3ee;

        color: #263f35;

        font-family: inherit;

        font-size: 21px;

        font-weight: 700;

        cursor: pointer;

        appearance: none;

        -webkit-appearance: none;

        transition:

            transform 0.15s,

            box-shadow 0.15s,

            **background** 0.15s;

    }

    .grouping-answer:hover {

        background: #e1ebe2;

        transform: translateY(-2px);

        box-shadow: 0 5px 14px rgba(50, 70, 55, 0.08);

    }

    .grouping-answer:active {

        transform: scale(0.97);

    }

    .grouping-answer:disabled {

        cursor: default;

    }

    /* 01B — samakan tombol jawaban persis dengan tombol 01A */

    .grouping-answers .grouping-answer {

        width: 100% !important;

        min-height: 50px !important;

        padding: 0 10px !important;

        border: none !important;

        border-radius: 14px !important;

        background: #edf3ee !important;

        color: #263f35 !important;

        font-family: inherit !important;

        font-size: 21px !important;

        font-weight: 700 !important;

        line-height: normal !important;

        text-align: center !important;

        cursor: pointer !important;

        appearance: none !important;

        -webkit-appearance: none !important;

        box-shadow: none !important;

        outline: none;

    }

    .grouping-answers .grouping-answer:hover {

        background: #e1ebe2 !important;

        transform: translateY(-2px);

        box-shadow: 0 5px 14px rgba(50, 70, 55, 0.08) !important;

    }

    .grouping-answers .grouping-answer:active {

        transform: scale(0.97);

    }

    /* 01B answer buttons are created dynamically by JavaScript.

       Astro scoped CSS does not attach the scope attribute to those

       runtime-created buttons, so this block must be global. */

    :global(.grouping-answers .grouping-answer) {

        width: 100%;

        min-height: 50px;

        padding: 0;

        border: none;

        border-radius: 14px;

        background: #edf3ee;

        color: #263f35;

        font-family: inherit;

        font-size: 21px;

        font-weight: 700;

        line-height: normal;

        text-align: center;

        cursor: pointer;

        appearance: none;

        -webkit-appearance: none;

        box-shadow: none;

        outline: none;

        transition:

            transform 0.15s,

            box-shadow 0.15s,

            **background** 0.15s;

    }

    :global(.grouping-answers .grouping-answer:hover) {

        background: #e1ebe2;

        transform: translateY(-2px);

        box-shadow: 0 5px 14px rgba(50, 70, 55, 0.08);

    }

    :global(.grouping-answers .grouping-answer:active) {

        transform: scale(0.97);

    }

    :global(.grouping-answers .grouping-answer:disabled) {

        cursor: default;

    }

    .grouping-mimi {

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        margin-top: 7px;

    }

    .grouping-mimi img {

