    const resultScreen = document.getElementById("result-screen")!;

    const finalScoreElement = document.getElementById("final-score")!;

    const playAgainButton = document.getElementById("play-again")!;

    const exerciseInfo = document.querySelector(".exercise-info")!;

    const subexerciseButtons = document.querySelectorAll(".subexercise-button");

    const groupingContent = document.getElementById("grouping-content")!;

    const exerciseTitle = document.querySelector(".exercise-info h1")!;

    const exerciseDescription = document.querySelector(".exercise-info p")!;

    const subexercise01A = document.querySelectorAll(".subexercise-01a");

    /* ========================================

       01B · GROUPING GAME

    ======================================== */

    const pondArea = document.getElementById("pond-area") as HTMLDivElement;

    const fishLayer = document.getElementById("fish-layer") as HTMLDivElement;

    const net = document.getElementById("net") as HTMLDivElement;

    const fishGroups = document.getElementById("fish-groups") as HTMLDivElement;

    const groupingQuestion = document.getElementById("grouping-question") as HTMLDivElement;

    const groupingAnswers = document.getElementById("grouping-answers") as HTMLDivElement;

    const groupingMimiMessage = document.getElementById("grouping-mimi-message") as HTMLDivElement;

    const scoopEffect = document.getElementById("scoop-effect") as HTMLDivElement;

    let groupingActive = false;

    let groupingTotalFish = 0;

    let groupingRemaining = 0;

    let groupingCount = 0;

    let groupingQuestionNumber = 0;

    let groupingAnswering = false;

    let groupingCorrectGroups = 0;

    let groupingCorrectRemaining = 0;

    let netDragging = false;

    let netPointerOffsetX = 0;

    let netPointerOffsetY = 0;

    const groupingTotals = [10, 14, 16, 20, 23, 26, 30];

    function setGroupingMessage(message: string, wrong = false) {

        groupingMimiMessage.classList.toggle("wrong-message", wrong);

        groupingMimiMessage.innerHTML = `

            <strong>Mimi</strong>

            <p>${message}</p>

        `;

    }

    function randomGroupingTotal() {

        return groupingTotals[Math.floor(Math.random() * groupingTotals.length)];

    }

    function resetNetPosition() {

        net.style.left = "50%";

        net.style.top = "50%";

        net.style.transform = "translate(-50%, -50%) rotate(-8deg)";

    }

    function renderFish() {

        fishLayer.innerHTML = "";

        const fishCount = Math.min(groupingRemaining, 30);

        const cells = Array.from({ length: 32 }, (_, index) => index);

        // Acak posisi grid 8 kolom × 4 baris, lalu isi sebanyak ikan yang tersisa.

        for (let i = cells.length - 1; i > 0; i--) {

            const j = Math.floor(Math.random() * (i + 1));

            [cells[i], cells[j]] = [cells[j], cells[i]];

        }

        // Maksimal 50% ikan menghadap kanan. Sisanya menghadap kiri.

        const leftIndices = Array.from({ length: fishCount }, (_, index) => index);

        const rightCount = Math.floor(fishCount / 2);

        for (let i = leftIndices.length - 1; i > 0; i--) {

            const j = Math.floor(Math.random() * (i + 1));

            [leftIndices[i], leftIndices[j]] = [leftIndices[j], leftIndices[i]];

        }

        const rightIndices = new Set(leftIndices.slice(0, rightCount));

        for (let i = 0; i < fishCount; i++) {

            const cell = cells[i];

            const column = (cell % 8) + 1;

            const row = Math.floor(cell / 8) + 1;

            const fish = document.createElement("img");

            fish.className = rightIndices.has(i)

                ? "pond-fish"

                : "pond-fish facing-left";

            fish.src = "/assets/ikan.png";

            fish.alt = "Ikan";

            fish.draggable = false;

            fish.style.gridColumn = String(column);

            fish.style.gridRow = String(row);

            fish.style.setProperty(

                "--fish-tilt",

                Math.random() > 0.5 ? "4deg" : "-4deg",

            );

            fish.style.setProperty(

                "--fish-delay",

                `${-(Math.random() * 1.7).toFixed(2)}s`,

            );

            fishLayer.appendChild(fish);

        }

    }

    function renderGroups(remainderFish = 0) {
        fishGroups.innerHTML = "";

        // Tank kanan selalu memiliki tepat 4 grid besar (2 × 2).
        // Setiap grid besar dibagi menjadi 2 baris × 3 kolom = 6 cell kecil.
        for (let slot = 0; slot < 4; slot++) {
            const group = document.createElement("div");
            group.className = "fish-group";

            const cellGrid = document.createElement("div");
            cellGrid.className = "group-cell-grid";

            const cells: HTMLDivElement[] = [];

            for (let cell = 0; cell < 6; cell++) {
                const cellElement = document.createElement("div");
                cellElement.className = "group-cell";
                cellGrid.appendChild(cellElement);
                cells.push(cellElement);
            }

            group.appendChild(cellGrid);

            // Satu kantong = satu kelompok 10 dan menempati satu grid besar.
            if (slot < groupingCount) {
                const bundledFish = document.createElement("img");
                bundledFish.className = "group-fish";
                bundledFish.src = "/assets/ikan-bungkus.png";
                bundledFish.alt = "10 ikan";
                bundledFish.draggable = false;
                group.appendChild(bundledFish);
            }

            // Ikan sisa masuk ke grid BESAR berikutnya, langsung ke cell kecilnya.
            // Urutan: 3 ikan di baris atas, lalu lanjut ke baris berikutnya.
            if (slot === groupingCount && remainderFish > 0) {
                for (let i = 0; i < remainderFish && i < cells.length; i++) {
                    const fish = document.createElement("img");
                    fish.className = "remainder-fish";
                    fish.src = "/assets/ikan.png";
                    fish.alt = "Ikan";
                    fish.draggable = false;
                    fish.style.setProperty(
                        "--fish-tilt",
                        Math.random() > 0.5 ? "4deg" : "-4deg",
                    );
                    fish.style.setProperty(
                        "--fish-delay",
                        `${-(Math.random() * 1.7).toFixed(2)}s`,
                    );
                    cells[i].appendChild(fish);
                }
            }

            fishGroups.appendChild(group);
        }
    }

    function formatGroupingAnswer(groups: number, remainder: number) {

        return remainder === 0

            ? `${groups} kelompok 10`

            : `${groups} kelompok 10 dan ${remainder} ikan`;

    }

    function prepareGroupingQuestion() {

        groupingQuestion.classList.remove("hidden");

        groupingAnswers.innerHTML = "";

        groupingAnswering = false;

        const correctText = formatGroupingAnswer(

            groupingCorrectGroups,

            groupingCorrectRemaining,

        );

        const choices = [correctText];

        while (choices.length < 4) {

            const groups = Math.max(1, groupingCorrectGroups + Math.floor(Math.random() * 3) - 1);

            const remainder = Math.floor(Math.random() * 8);

            const text = formatGroupingAnswer(groups, remainder);

            if (!choices.includes(text)) {

                choices.push(text);

            }

        }

        choices.sort(() => Math.random() - 0.5);

        choices.forEach((choice) => {

            const button = document.createElement("button");

            button.type = "button";

            button.className = "grouping-answer";

            button.textContent = choice;

            button.addEventListener("click", () => checkGroupingAnswer(choice));

            groupingAnswers.appendChild(button);

        });

        setGroupingMessage("Sekarang, berapa kelompok 10 dan berapa ikan yang tersisa?");

    }

    function finishGroupingQuestion() {

        groupingQuestion.classList.add("hidden");

        groupingCount = 0;

        groupingRemaining = 0;

        groupingActive = false;

        resetNetPosition();

        if (groupingQuestionNumber >= totalQuestions) {

            window.location.href =

                `/hasil-latihan?kelas=2&latihan=menghitung-benda&skor=${score}`;

            return;

        }

        startGroupingQuestion();

    }

    function checkGroupingAnswer(answer: string) {

        if (groupingAnswering) return;

        groupingAnswering = true;

        const correct =

            answer === formatGroupingAnswer(

                groupingCorrectGroups,

                groupingCorrectRemaining,

            );

        if (correct) {

            score += 10;

            scoreElement.textContent = String(score);

            setGroupingMessage("Hebat! Kamu sudah mengelompokkannya! 🎉");

            launchConfetti();

            setTimeout(finishGroupingQuestion, 700);

        } else {

            groupingAnswering = false;

            setGroupingMessage("Belum tepat. Coba perhatikan kelompok 10-nya lagi! 💪", true);

        }

    }

    function scoopFish() {
        if (!groupingActive || groupingRemaining <= 0 || groupingAnswering) return;

        const scoopCount = Math.min(10, groupingRemaining);
        const fish = Array.from(fishLayer.querySelectorAll(".pond-fish"));

        fish.slice(0, scoopCount).forEach((fishElement, index) => {
            setTimeout(() => fishElement.classList.add("caught"), index * 22);
        });

        groupingRemaining -= scoopCount;

        if (scoopCount === 10) {
            groupingCount += 1;
        }

        scoopEffect.classList.remove("hidden");
        void scoopEffect.offsetWidth;
        scoopEffect.classList.add("hidden");

        setTimeout(() => {
            renderFish();

            const remainderFish =
                groupingRemaining === 0 && scoopCount < 10 ? scoopCount : 0;

            renderGroups(remainderFish);

            if (groupingRemaining === 0) {
                groupingActive = false;
                net.style.cursor = "default";
                prepareGroupingQuestion();
            } else {
                setGroupingMessage(
                    "Bagus! Satu kelompok lagi berisi 10 ikan. 🎣",
                );
            }
        }, 350);
    }

    function netIsOverPond() {

        const netRect = net.getBoundingClientRect();

        const pondRect = pondArea.getBoundingClientRect();

        const cx = netRect.left + netRect.width / 2;

        const cy = netRect.top + netRect.height / 2;

        return (

            cx >= pondRect.left + 15 &&

            cx <= pondRect.right - 15 &&

            cy >= pondRect.top + 15 &&

            cy <= pondRect.bottom - 15

        );

    }

    function startGroupingQuestion() {

        groupingQuestionNumber++;

        progressElement.textContent = `Soal ${groupingQuestionNumber} / ${totalQuestions}`;

        groupingTotalFish = randomGroupingTotal();

        groupingRemaining = groupingTotalFish;

        groupingCount = 0;

        groupingCorrectGroups = Math.floor(groupingTotalFish / 10);

        groupingCorrectRemaining = groupingTotalFish % 10;

        groupingActive = true;

        groupingAnswering = false;

        groupingQuestion.classList.add("hidden");

        net.style.cursor = "grab";

        resetNetPosition();

        renderFish();

        fishGroups.innerHTML = "";

        setGroupingMessage("Ayo jaring ikan! Sekali menjaring, dapat 10 ikan. Jika tersisa kurang dari 10, jaring semuanya. 🎣");

    }

    function activateGroupingMode() {

        groupingQuestionNumber = 0;

        startGroupingQuestion();

    }

    function updateNetPosition(clientX: number, clientY: number) {

        const rect = pondArea.getBoundingClientRect();

        const x = Math.max(48, Math.min(rect.width - 48, clientX - rect.left - netPointerOffsetX));

        const y = Math.max(55, Math.min(rect.height - 55, clientY - rect.top - netPointerOffsetY));

        net.style.left = `${x}px`;

        net.style.top = `${y}px`;

        net.style.transform = "translate(-50%, -50%) rotate(-8deg)";

    }

    net.addEventListener("pointerdown", (event) => {

        if (!groupingActive || groupingRemaining <= 0) return;

        netDragging = true;

        net.setPointerCapture(event.pointerId);

        const netRect = net.getBoundingClientRect();

        netPointerOffsetX = event.clientX - (netRect.left + netRect.width / 2);

        netPointerOffsetY = event.clientY - (netRect.top + netRect.height / 2);

        net.classList.add("dragging");

    });

    net.addEventListener("pointermove", (event) => {

        if (!netDragging) return;

        updateNetPosition(event.clientX, event.clientY);

    });

    net.addEventListener("pointerup", () => {

        if (!netDragging) return;

        netDragging = false;

        net.classList.remove("dragging");

        if (netIsOverPond()) {

            scoopFish();

        } else {

            resetNetPosition();

        }

    });

    net.addEventListener("keydown", (event) => {

        if ((event.key === "Enter" || event.key === " ") && groupingActive) {

            event.preventDefault();

            scoopFish();

        }

    });



    /* ========================================

       SUB LATIHAN

    ======================================== */

    function switchSubexercise(subexercise: string) {

        subexerciseButtons.forEach((button) => {

            const isActive =

                (button as HTMLButtonElement).dataset.subexercise === subexercise;

            button.classList.toggle("active", isActive);

            button.setAttribute("aria-selected", String(isActive));

        });

        if (subexercise === "01B") {

            subexercise01A.forEach((element) => element.classList.add("hidden"));

            groupingContent.classList.remove("hidden");

            exerciseTitle.textContent = "Menghitung dengan Mengelompokkan";

            exerciseDescription.textContent =

                "Jaring ikan menjadi kelompok 10.";

            activateGroupingMode();

        } else {

            groupingContent.classList.add("hidden");

            subexercise01A.forEach((element) => element.classList.remove("hidden"));

            exerciseTitle.textContent = "Menghitung Benda di Alam";

            exerciseDescription.textContent =

                "Hitung jumlah benda yang ada di gambar.";

        }

    }

    subexerciseButtons.forEach((button) => {

        button.addEventListener("click", () => {

            const subexercise =

                (button as HTMLButtonElement).dataset.subexercise || "01A";

            switchSubexercise(subexercise);

        });

    });

    /* ========================================

       MIMI MESSAGE

    ======================================== */

    function setMimiMessage(message: string) {

        mimiMessage.classList.remove("wrong-message");

        mimiMessage.innerHTML = `

            <strong>Mimi</strong>

            <p>${message}</p>

        `;

    }

    function setWrongMessage(message: string) {

        mimiMessage.classList.add("wrong-message");

        mimiMessage.innerHTML = `

            <strong>Mimi</strong>

            <p>${message}</p>

        `;

    }

    /* ========================================

       GENERATE QUESTION

    ======================================== */

    function generateQuestion() {

        answering = false;

        questionNumber++;

        progressElement.textContent = `Soal ${questionNumber} / ${totalQuestions}`;

        const objects = ["🍎", "🌸", "🍃", "🪨", "🐚", "🌰"];

        const object = objects[Math.floor(Math.random() * objects.length)];

        const amount = Math.floor(Math.random() * 8) + 2;

        correctAnswer = amount;

        const objectHTML = Array.from(

            { length: amount },

            () => `<span class="counting-object">${object}</span>`,

        ).join("");

        questionElement.innerHTML = `

            <div class="counting-objects">

                ${objectHTML}

            </div>

        `;

        showNormalAnswers(correctAnswer);

    }

    /* ========================================

       ANSWERS

    ======================================== */

    function showNormalAnswers(answer: number) {

        const answers: number[] = [answer];

        while (answers.length < 4) {

            const wrongAnswer = answer + Math.floor(Math.random() * 7) - 3;

            if (wrongAnswer >= 0 && !answers.includes(wrongAnswer)) {

                answers.push(wrongAnswer);

            }

        }

        answers.sort(() => Math.random() - 0.5);

        answerButtons.forEach((button, index) => {

            const answerButton = button as HTMLButtonElement;

            answerButton.disabled = false;

            answerButton.textContent = String(answers[index]);

            answerButton.onclick = () => {

                checkAnswer(answers[index]);

            };

        });

    }

    /* ========================================

       CHECK ANSWER

    ======================================== */

    function checkAnswer(answer: number) {

        if (answering) {

            return;

        }

        if (answer === correctAnswer) {

            answering = true;

            score += 10;

            scoreElement.textContent = String(score);

            setMimiMessage("Hebat! Jawabanmu benar! 🎉");

            launchConfetti();

            mimiElement.classList.remove("wrong", "correct");

            void mimiElement.offsetWidth;

            mimiElement.classList.add("correct");

            answerButtons.forEach((button) => {

                (button as HTMLButtonElement).disabled = true;

            });

            setTimeout(nextQuestion, 800);

        } else {

            setWrongMessage("Belum tepat. Coba lagi! 💪");

            mimiElement.classList.remove("correct", "wrong");

            void mimiElement.offsetWidth;

            mimiElement.classList.add("wrong");

        }

    }

    /* ========================================

       NEXT QUESTION

    ======================================== */

    function nextQuestion() {

        mimiElement.classList.remove("correct", "wrong");

        if (questionNumber >= totalQuestions) {

            showResult();

        } else {

            setMimiMessage("Ayo hitung benda-bendanya! 🌿");

            generateQuestion();

        }

    }

    /* ========================================

       RESULT

    ======================================== */

    function showResult() {

    window.location.href =

    `/hasil-latihan?kelas=2&latihan=menghitung-benda&skor=${score}`;

}

    /* ========================================

       PLAY AGAIN

    ======================================== */

    playAgainButton.addEventListener("click", () => {

        score = 0;

        questionNumber = 0;

        correctAnswer = 0;

        answering = false;

        scoreElement.textContent = "0";

        resultScreen.classList.add("hidden");

        exerciseInfo.classList.remove("hidden");

        document.querySelector("#mimi-area")!.classList.remove("hidden");

        document.querySelector(".question-card")!.classList.remove("hidden");

        document.querySelector(".answers")!.classList.remove("hidden");

        setMimiMessage("Ayo hitung benda-bendanya! 🌿");

        generateQuestion();

    });

    /* ========================================

       START

    ======================================== */

    generateQuestion();

    /* ========================================

       CONFETTI

    ======================================== */

    function launchConfetti() {

        const container = document.createElement("div");

        container.style.position = "fixed";

        container.style.left = "0";

        container.style.top = "0";

        container.style.width = "100vw";

        container.style.height = "100vh";

        container.style.pointerEvents = "none";

        container.style.overflow = "hidden";

        container.style.zIndex = "999999";

        document.body.appendChild(container);

        const colors = [

            "#7FAF8B",

            "#E8B86D",

            "#D98282",

            "#8FA8C7",

            "#C99A6B",

            "#F3C6C6",

            "#A8D8B9",

        ];

        for (let i = 0; i < 100; i++) {

            const piece = document.createElement("div");

            const size = 8 + Math.random() * 7;

            piece.style.position = "absolute";

            piece.style.width = `${size}px`;

            piece.style.height = `${size * 1.5}px`;

            piece.style.backgroundColor =

                colors[Math.floor(Math.random() * colors.length)];

            piece.style.left = `${Math.random() * 100}vw`;

            piece.style.top = "-30px";

            piece.style.borderRadius = "3px";

            container.appendChild(piece);

            const x = (Math.random() - 0.5) * 300;

            const y = 500 + Math.random() * 400;

            const rotation = 360 + Math.random() * 720;

            piece.animate(

                [

                    {

                        transform: "translate3d(0, 0, 0) rotate(0deg)",

                        opacity: 1,

                    },

                    {

                        transform: `translate3d(${x}px, ${y}px, 0) rotate(${rotation}deg)`,

                        opacity: 0,

                    },

                ],

                {

                    duration: 1800 + Math.random() * 1000,

                    delay: Math.random() * 200,

                    easing: "cubic-bezier(.2,.8,.3,1)",

                    fill: "forwards",

                },

            );

        }

        setTimeout(() => {

            container.remove();

        }, 3500);

    }

</script>