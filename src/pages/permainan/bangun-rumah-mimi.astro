---

import MainLayout from "../../layouts/MainLayout.astro";

import Header from "../../components/Header.astro";

---

<MainLayout title="Bangun Rumah Mimi — Mimi Matematika">

 <Header />

 <main class="game-page">

<div class="game-body">

<div class="game-topbar">

<a href="/permainan">← Kembali ke permainan</a>

<span>🏠 Game Mimi</span>

<span></span>

</div>

            <section class="game-content">

                <!-- INTRO -->

                <div id="game-intro">

                    <div class="game-icon">🏠</div>

                    <h1>Bangun Rumah Mimi</h1>

                    <button id="start-game" class="start-game-button" type="button">

                        <span>🪑</span>

                        <strong>Mulai Game</strong>

                        <span>▶</span>

                    </button>

                </div>

                <!-- GAME -->

                <div id="house-game" class="house-game hidden">

                    <div class="house-title-row">

                        <h1>🏠 Bangun Rumah Mimi</h1>

                    </div>

                    <!-- MAIN GAME AREA — IXL-STYLE DECORATION SCREEN -->

                    <div class="game-stage">

                        <div class="decorate-card">
<!-- LARGE HOUSE / PLAY AREA -->

                            <div class="stage-main">

                                <div class="house-screen">

<div class="house-screen-top">

    <span class="house-screen-title">👆 klik furniture, lalu klik ruangan.</span>

    <div class="house-screen-actions">

        <button id="capture-house" class="capture-house-button" type="button" aria-label="Capture rumah">
            📷 Capture
        </button>

        <button id="clear-house" class="capture-house-button" type="button" aria-label="Mulai lagi">
            🔄 Mulai Lagi
        </button>

    </div>

</div>

                                    <div id="house-board" class="house-board" aria-label="Rumah Mimi">
    <img id="house-base" class="house-base" src="/assets/dekorumah/rumah.png" alt="Rumah Mimi" draggable="false" />
    <div id="room-grids" class="room-grids" aria-hidden="false">
        <!-- ROOM TILES: these define the exact usable floor area of each room. Each room uses its own grid dimensions. -->
        <div class="room-tile" data-tile-room="kamar" data-room-pos="top-left"><div class="room-grid" data-grid-room="kamar"></div></div>
        <div class="room-tile" data-tile-room="dapur" data-room-pos="top-right"><div class="room-grid" data-grid-room="dapur"></div></div>
        <div class="room-tile" data-tile-room="ruang-tamu" data-room-pos="bottom-left"><div class="room-grid" data-grid-room="ruang-tamu"></div></div>
        <div class="room-tile" data-tile-room="perpustakaan" data-room-pos="bottom-right"><div class="room-grid" data-grid-room="perpustakaan"></div></div>
    </div>
    <div id="placed-items" class="placed-items"></div>
</div>

<!-- FLOATING FURNITURE PANEL -->

                                    <div id="furniture-panel" class="furniture-panel">
                                <!-- <div class="mouse-coord-display" id="mouse-coord-display">Mouse: —</div>-->
                                <div class="room-tabs-bottom" role="tablist" aria-label="Pilih ruangan">
                                    <button class="room-tab active" type="button" data-room="kamar" role="tab" aria-selected="true">
                                        <span class="room-tab-icon">🛏️</span>
                                        <span class="room-tab-label">Kamar</span>
                                    </button>
                                    <button class="room-tab" type="button" data-room="dapur" role="tab" aria-selected="false">
                                        <span class="room-tab-icon">🍳</span>
                                        <span class="room-tab-label">Dapur</span>
                                    </button>
                                    <button class="room-tab" type="button" data-room="ruang-tamu" role="tab" aria-selected="false">
                                        <span class="room-tab-icon">🛋️</span>
                                        <span class="room-tab-label">Ruang Tamu</span>
                                    </button>
                                    <button class="room-tab" type="button" data-room="perpustakaan" role="tab" aria-selected="false">
                                        <span class="room-tab-icon">🪴</span>
                                        <span class="room-tab-label">Perpustakaan</span>
                                    </button>
                                    <button class="room-tab" type="button" data-room="rockstar" role="tab" aria-selected="false">
                                        <span class="room-tab-icon">🎸</span>
                                        <span class="room-tab-label">Rockstar</span>
                                    </button>
                                    <button class="room-tab" type="button" data-room="pixel" role="tab" aria-selected="false">
                                        <span class="room-tab-icon">🧱</span>
                                        <span class="room-tab-label">Pixel</span>
                                    </button>
                                </div>
<!-- KAMAR -->
<div class="room-content active" data-content="kamar">
    <div class="asset-group">
        <span class="asset-group-title">🛏️ Bed — 3×4 grid</span>
        <div class="asset-row">
            { ["bed1", "bed2"].map((name) => (
                <button class="asset-card" type="button" data-type="bed" data-src={`/assets/dekorumah/kamar/${name}.png`}>
                    <img src={`/assets/dekorumah/kamar/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
    <div class="asset-group">
        <span class="asset-group-title">🧸 Rug — 4×4 grid</span>
        <div class="asset-row">
            { ["rug1", "rug2", "rug3"].map((name) => (
                <button class="asset-card" type="button" data-type="rug" data-src={`/assets/dekorumah/kamar/${name}.png`}>
                    <img src={`/assets/dekorumah/kamar/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
    <div class="asset-group">
        <span class="asset-group-title">🪑 Furniture Kamar</span>
        <div class="asset-row">
            { [
                "bangku1", "bantal1", "bantal2", "bantal3",
                "bufet1", "kotak-main1",
                "lemari1", "lemari2", "meja-belajar1", "meja-rias1",
                "nakas1", "nakas2", "tanaman1"
            ].map((name) => (
                <button
  class="asset-card"
  type="button"
  data-type={
    (name === "lemari1" || name === "lemari2")
      ? "wardrobe"
      : (["nakas1","nakas2","meja-rias1","meja-belajar1"].includes(name)
          ? "tallDecor"
          : "decor")
  }
  data-src={`/assets/dekorumah/kamar/${name}.png`}
>
  <img
    src={`/assets/dekorumah/kamar/${name}.png`}
    alt={name}
    draggable="false"
  />
</button>
            )) }
        </div>
    </div>
</div>

<!-- DAPUR -->
<div class="room-content" data-content="dapur">
    <div class="asset-group">
        <span class="asset-group-title">🍽️ Meja Makan — 5×4 grid</span>
        <div class="asset-row">
            <button class="asset-card" type="button" data-type="diningTable" data-src="/assets/dekorumah/dapur/meja-makan1.png">
                <img src="/assets/dekorumah/dapur/meja-makan1.png" alt="meja-makan1" draggable="false" />
            </button>
        </div>
    </div>

    <div class="asset-group">
        <span class="asset-group-title">🪵 Bufet & Kursi Makan</span>
        <div class="asset-row">
            { ["bufet-makan1", "bufet-makan2"].map((name) => (
                <button class="asset-card" type="button" data-type="diningBuffet" data-src={`/assets/dekorumah/dapur/${name}.png`}>
                    <img src={`/assets/dekorumah/dapur/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
    <div class="asset-group">
        <span class="asset-group-title">🛒 Troli Makan — 2×3 grid</span>
        <div class="asset-row">
            { ["troli-makan1", "troli-makan2"].map((name) => (
                <button class="asset-card" type="button" data-type="diningTrolley" data-src={`/assets/dekorumah/dapur/${name}.png`}>
                    <img src={`/assets/dekorumah/dapur/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
    <div class="asset-group">
        <span class="asset-group-title">🌿 Tanaman Indoor</span>
        <div class="asset-row">
            { ["tanaman-makan2", "tanaman-makan3"].map((name) => (
                <button class="asset-card" type="button" data-type="diningPlant" data-src={`/assets/dekorumah/dapur/${name}.png`}>
                    <img src={`/assets/dekorumah/dapur/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
    <div class="asset-group">
        <span class="asset-group-title">🖼️ Hiasan Dinding</span>
        <div class="asset-row">
            { ["lukisan1", "lukisan2", "lukisan3", "lukisan4"].map((name) => (
                <button class="asset-card" type="button" data-type="wallArt" data-src={`/assets/dekorumah/dapur/${name}.png`}>
                    <img src={`/assets/dekorumah/dapur/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
    <div class="asset-group">
        <span class="asset-group-title">🐢🐱 Peliharaan</span>
        <div class="asset-row">
            { ["pet-kura1", "kucing"].map((name) => (
                <button class="asset-card" type="button" data-type="pet" data-src={`/assets/dekorumah/dapur/${name}.png`}>
                    <img src={`/assets/dekorumah/dapur/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
    <div class="asset-group">
        <span class="asset-group-title">🥣 Tempat Makan & Minum</span>
        <div class="asset-row">
            { ["makan-kura1", "minum-kura1"].map((name) => (
                <button class="asset-card" type="button" data-type={name === "makan-kura1" ? "petBowl" : "petWater"} data-src={`/assets/dekorumah/dapur/${name}.png`}>
                    <img src={`/assets/dekorumah/dapur/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
</div>

<!-- RUANG TAMU -->
<div class="room-content" data-content="ruang-tamu">
    <div class="asset-group">
        <span class="asset-group-title">🛋️ Furniture Ruang Tamu</span>
        <div class="asset-row">
            { [
                "sofa",
                "japan-armchair",
                "japan-bufet",
                "japan-cushion1",
                "japan-cushion2",
                "japan-sofa",
                "japan-tatami",
                "shoji",
                "meja-tamu",
                "bufet1",
                "monstera",
                "meja-akuarium-ikan"
            ].map((name) => (
                <button
                    class="asset-card"
                    type="button"
          data-type={
    name === "sofa" || name === "japan-sofa"
        ? "sofa"
        : name === "japan-armchair"
            ? "kursikotak"
            : name === "shoji"
                ? "shoji"
                : name === "japan-cushion1" || name === "japan-cushion2"
                ? "decor"
                : name === "japan-bufet"
                    ? "livingBuffet"
                    : name === "japan-tatami"
                        ? "rug"
                        : name === "meja-akuarium-ikan"
                            ? "aquariumTable"
                            : name === "meja-tamu"
                                ? "coffeeTable"
                                : name === "monstera"
                                    ? "largePlant"
                                    : "livingBuffet"
}
                    data-src={`/assets/dekorumah/ruang-tamu/${name}.png`}
                >
                    <img
                        src={`/assets/dekorumah/ruang-tamu/${name}.png`}
                        alt={name}
                        draggable="false"
                    />
                </button>
            )) }
        </div>
    </div>
</div>

<!-- PERPUSTAKAAN -->
<div class="room-content" data-content="perpustakaan">
    <div class="asset-group">
        <span class="asset-group-title">📚 Furniture Perpustakaan</span>
        <div class="asset-row">
            
            <button class="asset-card" type="button" data-type="lampu" data-src="/assets/dekorumah/perpustakaan/lampu1.png">
                <img src="/assets/dekorumah/perpustakaan/lampu1.png" alt="lampu1" draggable="false" />
            </button>
            { ["rak-buku1", "rak-buku2"].map((name) => (
                <button class="asset-card" type="button" data-type="tallDecor" data-src={`/assets/dekorumah/perpustakaan/${name}.png`}>
                    <img src={`/assets/dekorumah/perpustakaan/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
            <button class="asset-card" type="button" data-type="mirror" data-src="/assets/dekorumah/perpustakaan/mirror.png">
                <img src="/assets/dekorumah/perpustakaan/mirror.png" alt="mirror" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="diningPlant" data-src="/assets/dekorumah/perpustakaan/tanaman-makan1.png">
                <img src="/assets/dekorumah/perpustakaan/tanaman-makan1.png" alt="tanaman-makan1" draggable="false" />
            </button>
            { [ "kursi1", "basket", "tub", "shower-box", "tisyu", "towel-tower", "toilet"].map((name) => (
                <button class="asset-card" type="button" data-type={
                    name === "toilet" ? "toilet"
                    : name === "kursi1" ? "kursikotak"
                    : name === "basket" ? "basket"
                    : name === "tub" ? "tub"
                    : name === "tisyu" ? "tisyu"
                    : name === "towel-tower" ? "towelTower"
                    : "showerBox"
                } data-src={`/assets/dekorumah/perpustakaan/${name}.png`}>
                    <img src={`/assets/dekorumah/perpustakaan/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
        </div>
    </div>
</div>

<!-- PIXEL -->
<div class="room-content" data-content="pixel">
    <div class="asset-group">
        <span class="asset-group-title">🧱 Pixel Furniture — Minecraft Inspired</span>
        <div class="asset-row">
            <button class="asset-card" type="button" data-type="pixelsofa" data-src="/assets/dekorumah/mine/mine-sofa.png"><img src="/assets/dekorumah/mine/mine-sofa.png" alt="mine-sofa" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="tableminecraft" data-src="/assets/dekorumah/mine/mine-table.png"><img src="/assets/dekorumah/mine/mine-table.png" alt="mine-table" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="minecraftBuffet" data-src="/assets/dekorumah/mine/mine-buffet.png"><img src="/assets/dekorumah/mine/mine-buffet.png" alt="mine-buffet" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="bigbed" data-src="/assets/dekorumah/mine/mine-bed.png"><img src="/assets/dekorumah/mine/mine-bed.png" alt="mine-bed" draggable="false" /></button>
            
            <button class="asset-card" type="button" data-type="bigbook" data-src="/assets/dekorumah/mine/mine-book.png"><img src="/assets/dekorumah/mine/mine-book.png" alt="mine-book" draggable="false" /></button>
            
            
            <button class="asset-card" type="button" data-type="bed" data-src="/assets/dekorumah/mine/mine-tree.png"><img src="/assets/dekorumah/mine/mine-tree.png" alt="mine-tree" draggable="false" /></button>            
            <button class="asset-card" type="button" data-type="toybox" data-src="/assets/dekorumah/mine/mine-toybox.png"><img src="/assets/dekorumah/mine/mine-toybox.png" alt="mine-toybox" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="chair" data-src="/assets/dekorumah/mine/mine-block-blue.png"><img src="/assets/dekorumah/mine/mine-block-blue.png" alt="mine-block-blue" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="chair" data-src="/assets/dekorumah/mine/mine-block-green.png"><img src="/assets/dekorumah/mine/mine-block-green.png" alt="mine-block-green" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="chair" data-src="/assets/dekorumah/mine/mine-block-pink.png"><img src="/assets/dekorumah/mine/mine-block-pink.png" alt="mine-block-pink" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="shoji" data-src="/assets/dekorumah/mine/mine-desk.png"><img src="/assets/dekorumah/mine/mine-desk.png" alt="mine-desk" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="bed" data-src="/assets/dekorumah/mine/mine-wardrobe.png"><img src="/assets/dekorumah/mine/mine-wardrobe.png" alt="mine-wardrobe" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="rug" data-src="/assets/dekorumah/mine/mine-rug.png"><img src="/assets/dekorumah/mine/mine-rug.png" alt="mine-rug" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="dinnertable" data-src="/assets/dekorumah/mine/mine-dinnertable.png"><img src="/assets/dekorumah/mine/mine-dinnertable.png" alt="mine-dinnertable" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="showerBox" data-src="/assets/dekorumah/mine/mine-runningpad.png"><img src="/assets/dekorumah/mine/mine-runningpad.png" alt="mine-runningpad" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="showerBox" data-src="/assets/dekorumah/mine/mine-parrotpet.png"><img src="/assets/dekorumah/mine/mine-parrotpet.png" alt="mine-parrotpet" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="chair" data-src="/assets/dekorumah/mine/mine-cat.png"><img src="/assets/dekorumah/mine/mine-cat.png" alt="mine-cat" draggable="false" /></button>
            <button class="asset-card" type="button" data-type="chair" data-src="/assets/dekorumah/mine/mine-bunny.png"><img src="/assets/dekorumah/mine/mine-bunny.png" alt="mine-bunny" draggable="false" /></button>
        
        </div>
    </div>
</div>

<!-- ROCKSTAR -->
<div class="room-content" data-content="rockstar">
    <div class="asset-group">
        <span class="asset-group-title">🎸 Rockstar Furniture</span>
        <div class="asset-row">
            <button class="asset-card" type="button" data-type="sofa" data-src="/assets/dekorumah/rockstar/rock-sofa.png">
                <img src="/assets/dekorumah/rockstar/rock-sofa.png" alt="rock-sofa" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="kursikotak" data-src="/assets/dekorumah/rockstar/rock-armchair.png">
                <img src="/assets/dekorumah/rockstar/rock-armchair.png" alt="rock-armchair" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="kursi" data-src="/assets/dekorumah/rockstar/rock-roundsofa.png">
                <img src="/assets/dekorumah/rockstar/rock-roundsofa.png" alt="rock-roundsofa" draggable="false" />
            </button>
           <button class="asset-card" type="button" data-type="rug" data-src="/assets/dekorumah/rockstar/rock-carpet.png">
                <img src="/assets/dekorumah/rockstar/rock-carpet.png" alt="rock-carpet" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="decor" data-src="/assets/dekorumah/rockstar/rock-ampli.png">
                <img src="/assets/dekorumah/rockstar/rock-ampli.png" alt="rock-ampli" draggable="false" />
            </button>
           
            { [ "rock-guitar2", "rock-guitar4"].map((name) => (
                <button class="asset-card" type="button" data-type="tallDecor" data-src={`/assets/dekorumah/rockstar/${name}.png`}>
                    <img src={`/assets/dekorumah/rockstar/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
            
            <button class="asset-card" type="button" data-type="largePlant" data-src="/assets/dekorumah/rockstar/rock-snakeplant.png">
                <img src="/assets/dekorumah/rockstar/rock-snakeplant.png" alt="rock-snakeplant" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="largePlant" data-src="/assets/dekorumah/rockstar/rock-monstera.png">
                <img src="/assets/dekorumah/rockstar/rock-monstera.png" alt="rock-monstera" draggable="false" />
            </button>
            { ["rock-poster1", "rock-poster2"].map((name) => (
                <button class="asset-card" type="button" data-type="wallArt" data-src={`/assets/dekorumah/rockstar/${name}.png`}>
                    <img src={`/assets/dekorumah/rockstar/${name}.png`} alt={name} draggable="false" />
                </button>
            )) }
            <button class="asset-card" type="button" data-type="bigTable" data-src="/assets/dekorumah/rockstar/rock-rak.png">
                <img src="/assets/dekorumah/rockstar/rock-rak.png" alt="rock-rak" draggable="false" />
            </button>    
            <button class="asset-card" type="button" data-type="coffeeTable" data-src="/assets/dekorumah/rockstar/rock-table.png">
                <img src="/assets/dekorumah/rockstar/rock-table.png" alt="rock-table" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="bigTable" data-src="/assets/dekorumah/rockstar/rock-table2.png">
                <img src="/assets/dekorumah/rockstar/rock-table2.png" alt="rock-table2" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="mirror" data-src="/assets/dekorumah/rockstar/rock-mirror.png">
                <img src="/assets/dekorumah/rockstar/rock-mirror.png" alt="rock-mirror" draggable="false" />
            </button>
            <button class="asset-card" type="button" data-type="tallDecor" data-src="/assets/dekorumah/rockstar/rock-lamp.png">
                <img src="/assets/dekorumah/rockstar/rock-lamp.png" alt="rock-lamp" draggable="false" />
            </button>
        </div>
    </div>
</div>                            </div>

                        </div>

                    </div>

                </div>

                </div>

                </div>

                <!-- RESULT -->

                <div id="game-result" class="game-result hidden"></div>

            </section>

        </div>


        <footer class="site-footer">

