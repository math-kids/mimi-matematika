<script>

    const intro = document.getElementById("game-intro") as HTMLDivElement;

    const startButton = document.getElementById("start-game") as HTMLButtonElement;

    const houseGame = document.getElementById("house-game") as HTMLDivElement;

    const board = document.getElementById("house-board") as HTMLDivElement;

    const placedItems = document.getElementById("placed-items") as HTMLDivElement;

    const resultScreen = document.getElementById("game-result") as HTMLDivElement;

    const captureHouseButton = document.getElementById("capture-house") as HTMLButtonElement;
    const clearButton = document.getElementById("clear-house") as HTMLButtonElement;

    const panelTitle = document.getElementById("panel-title") as HTMLElement;

    const panelSubtitle = document.getElementById("panel-subtitle") as HTMLElement;

    // BACKGROUND MUSIC — kalimba only; does not affect any furniture/game logic.
    const bgMusic = new Audio("/assets/dekorumah/kalimba.mp3");
    bgMusic.loop = true;
    bgMusic.volume = 0.20;

    // GAME SOUND EFFECTS
    // Semua SFX berada di /assets/dekorumah/ dan hanya dimainkan saat ada interaksi user.
    const soundClick = new Audio("/assets/dekorumah/click.mp3");
    const soundPickup = new Audio("/assets/dekorumah/pickup.mp3");
    const soundPlace = new Audio("/assets/dekorumah/place.mp3");
    const soundError = new Audio("/assets/dekorumah/error.mp3");
    const soundDelete = new Audio("/assets/dekorumah/delete.mp3");
    const soundTab = new Audio("/assets/dekorumah/tab.mp3");

    [soundClick, soundPickup, soundPlace, soundError, soundDelete, soundTab].forEach(sound => {
        sound.preload = "auto";
        sound.volume = 0.55;
    });

    function playSound(sound:HTMLAudioElement) {
        sound.currentTime = 0;
        sound.play().catch(() => {});
    }

    function startBackgroundMusic() {
        bgMusic.play().catch(() => {});
    }

    function stopBackgroundMusic() {
        bgMusic.pause();
        bgMusic.currentTime = 0;
    }

    type FurnitureType = "bed" |"bigTable"|"tableminecraft"|"bigbook"| "bigbed" |"minecraftBuffet"|"pixelsofa"|"toybox"|"rug" | "dinnertable"|"chair" | "shoji" | "mirror" | "decor" | "wardrobe" | "tallDecor" | "lampu" | "diningTable" | "diningChair" | "diningBuffet" | "diningTrolley" | "diningPlant" | "wallArt" | "pet" | "petBowl" | "petWater" | "sofa" | "coffeeTable" | "livingBuffet" | "largePlant" | "aquariumTable" | "toilet" | "kursi" | "kursikotak" | "basket" | "tub" | "tisyu" | "towelTower" | "showerBox";
    type PlacedItem = { id:number; src:string; type:FurnitureType; room:string; col:number; row:number; };

    const ROOM_GRID_SIZES: Record<string,number> = { kamar:11, dapur:11, "ruang-tamu":10, perpustakaan:8 };
    // Kamar: 10×9 total = 1 kolom tambahan di kiri + 9 baris.
    // Semua cell Kamar memakai ukuran fisik yang sama.
    // Dapur: 11×7.
    // Cell size is matched to the Perpustakaan 8×8 grid cell size.
    const ROOM_GRID_COLS: Record<string,number> = { kamar:11, dapur:11, "ruang-tamu":10, perpustakaan:8 };
    const ROOM_GRID_ROWS: Record<string,number> = { kamar:9, dapur:9, "ruang-tamu":9, perpustakaan:8 };
    const getGridCols = (room:string) => ROOM_GRID_COLS[room] ?? 8;
    const getGridRows = (room:string) => ROOM_GRID_ROWS[room] ?? 8;
    const getGridSize = (room:string) => ROOM_GRID_SIZES[room] ?? 8;
    const FOOTPRINTS: Record<FurnitureType,{cols:number;rows:number}> = {
        bed: { cols:3, rows:4 },
        pixelsofa: {cols:6, rows:3},
        toybox: { cols:3, rows:2 },
        bigbed: { cols:5, rows:5 },
        rug: { cols:4, rows:4 },
        shoji: { cols:4, rows:3 },
        bigbook: { cols:6, rows:4 },
        mirror: { cols:4, rows:3 },
        // Lemari dibuat lebih tinggi: 2 kolom × 4 baris.
        wardrobe: { cols:2, rows:4 },
        // Nakas, meja, dan rak buku dibuat lebih tinggi agar proporsinya tidak gepeng.
        tallDecor: { cols:2, rows:3 },
        lampu: { cols:1, rows:2 },
        diningTable: { cols:5, rows:4 },
        dinnertable: { cols:5, rows:4 },
        diningChair: { cols:1, rows:2 },
        diningBuffet: { cols:2, rows:3 },
        minecraftBuffet: { cols:6, rows:2 },
        diningTrolley: { cols:2, rows:3 },
        diningPlant: { cols:2, rows:2 },
        wallArt: { cols:1, rows:1 },
        pet: { cols:1, rows:1 },
        petBowl: { cols:2, rows:1 },
        petWater: { cols:1, rows:1 },
        sofa: { cols:5, rows:3 },
        coffeeTable: { cols:3, rows:2 },
        bigTable: { cols:3, rows:3 },
        tableminecraft: { cols:4, rows:3 },
        chair: { cols:2, rows:2 },
        livingBuffet: { cols:5, rows:3 },
        largePlant: { cols:2, rows:3 },
        aquariumTable: { cols:5, rows:4 },
        // Bathroom / utility assets — masing-masing punya footprint sendiri.
        toilet: { cols:2, rows:2 },
        kursi: { cols:2, rows:2 },
        kursikotak: { cols:2, rows:2 },
        basket: { cols:2, rows:2 },
        tub: { cols:3, rows:2 }, // lebar 4 × tinggi 2
        tisyu: { cols:1, rows:1 },
        towelTower: { cols:2, rows:3 }, // lebar 2 × tinggi 3
        showerBox: { cols:3, rows:4 }, // lebar 2 × tinggi 4
        // Default bedroom decor.
        decor: { cols:2, rows:2 }
    };
    const ROOM_IDS = ["kamar","dapur","ruang-tamu","perpustakaan","rockstar"];

    // NEW FLOORPLAN GEOMETRY
    // Coordinate planes are fitted to the visible floor of house-floorplan.png.
    // Door leaves / wall intrusions are blocked so furniture footprints cannot occupy them.
    const ROOM_GEOMETRY: Record<string,{blocked:Set<string>}> = {
        kamar: { blocked: new Set() },
        //dapur: { blocked: new Set(["1,8","2,8", ...Array.from({length:5}, (_,row) => [8,9,10].map(col => `${col},${row+4}`)).flat()]) },
        "ruang-tamu": { blocked: new Set() },
        perpustakaan: { blocked: new Set(["0,0","0,1","0,2","1,0","1,1"]) }
    };

    function isCellValid(room:string, col:number, row:number) {
        return !ROOM_GEOMETRY[room]?.blocked.has(`${col},${row}`);
    }

    function isFootprintValid(room:string, type:FurnitureType, col:number, row:number) {
        const f = FOOTPRINTS[type];
        const gridCols = getGridCols(room);
        const gridRows = getGridRows(room);
        if (col < 0 || row < 0 || col + f.cols > gridCols || row + f.rows > gridRows) return false;
        for (let r = row; r < row + f.rows; r++) {
            for (let c = col; c < col + f.cols; c++) {
                if (!isCellValid(room,c,r)) return false;
            }
        }
        return true;
    }

    function findValidOrigin(room:string, type:FurnitureType, preferredCol:number, preferredRow:number) {
        const normalized = normalizeGridPosition(type, preferredCol, preferredRow, room);
        if (isFootprintValid(room,type,normalized.col,normalized.row)) return normalized;

        let best:{col:number;row:number;dist:number}|null = null;
        const gridCols = getGridCols(room);
        const gridRows = getGridRows(room);
        for (let row=0; row<=gridRows-FOOTPRINTS[type].rows; row++) {
            for (let col=0; col<=gridCols-FOOTPRINTS[type].cols; col++) {
                if (!isFootprintValid(room,type,col,row)) continue;
                const dist = Math.abs(col-normalized.col) + Math.abs(row-normalized.row);
                if (!best || dist < best.dist) best = {col,row,dist};
            }
        }
        return best ? {col:best.col,row:best.row} : null;
    }
    let items:PlacedItem[] = [];
    let nextId = 1;
    let activeRoom = "kamar";
    let selectedFurniture:{src:string;type:FurnitureType}|null = null;
    let selectedPlacedId:number|null = null;

    const getRoomGrid = (room:string) => document.querySelector<HTMLDivElement>(`[data-grid-room="${room}"]`);

    /**
     * GRID IS THE ONLY COORDINATE SYSTEM.
     * Every furniture item is stored as:
     *   room = room tile id
     *   col  = top-left / (0,0) cell of the furniture footprint
     *   row  = top-left / (0,0) cell of the furniture footprint
     *
     * No screen/pixel coordinates are stored in the item model.
     * Every move is converted to a room + grid cell first, then committed.
     */
    function normalizeGridPosition(type:FurnitureType, col:number, row:number, room:string = "kamar") {
        const f = FOOTPRINTS[type];
        const gridCols = getGridCols(room);
        const gridRows = getGridRows(room);
        return {
            col: Math.max(0, Math.min(gridCols - f.cols, Math.floor(col))),
            row: Math.max(0, Math.min(gridRows - f.rows, Math.floor(row)))
        };
    }

    function roomAtPoint(clientX:number, clientY:number):string|null {
        for (const room of ROOM_IDS) {
            const grid = getRoomGrid(room);
            if (!grid) continue;
            const r = grid.getBoundingClientRect();
            if (clientX >= r.left && clientX < r.right && clientY >= r.top && clientY < r.bottom) return room;
        }
        return null;
    }

    /** Convert mouse -> furniture origin (0,0) cell. The hovered cell IS the top-left origin; footprint extends right/down. */
    function pointToGrid(clientX:number, clientY:number, room:string, type:FurnitureType) {
        const grid = getRoomGrid(room);
        if (!grid) return null;
        const r = grid.getBoundingClientRect();
        if (clientX < r.left || clientX >= r.right || clientY < r.top || clientY >= r.bottom) return null;

        const gridCols = getGridCols(room);
        const gridRows = getGridRows(room);
        const col = Math.floor(((clientX - r.left) / r.width) * gridCols);
        const row = Math.floor(((clientY - r.top) / r.height) * gridRows);
        const pos = findValidOrigin(room,type,col,row);
        return pos ? { room, ...pos } : null;
    }

    function rawGridCell(clientX:number, clientY:number, room:string) {
        const grid = getRoomGrid(room);
        if (!grid) return null;
        const r = grid.getBoundingClientRect();
        if (clientX < r.left || clientX >= r.right || clientY < r.top || clientY >= r.bottom) return null;
        return {
            col: Math.max(0, Math.min(getGridCols(room) - 1, Math.floor(((clientX - r.left) / r.width) * getGridCols(room)))),
            row: Math.max(0, Math.min(getGridRows(room) - 1, Math.floor(((clientY - r.top) / r.height) * getGridRows(room))))
        };
    }

    function showMouseGridCoord(room:string, col:number, row:number) {
        const display = document.getElementById('mouse-coord-display');
        if (display) display.textContent = `Mouse: ${room}  (${col}, ${row})`;
    }

    function clearGridHover() {
        document.querySelectorAll<HTMLDivElement>('.room-grid.grid-hovering').forEach(grid => {
            grid.classList.remove('grid-hovering','footprint-preview','footprint-invalid');
            grid.style.setProperty('--hover-col', '-1');
            grid.style.setProperty('--hover-row', '-1');
            grid.style.setProperty('--hover-cols', '0');
            grid.style.setProperty('--hover-rows', '0');
        });
        const display = document.getElementById('mouse-coord-display');
        if (display) display.textContent = 'Mouse: —';
    }

    function showAllRoomGrids() {
        document.querySelectorAll<HTMLDivElement>('.room-grid').forEach(grid => {
            grid.classList.add('drag-grid-visible');
        });
    }

    function hideAllRoomGrids() {
        document.querySelectorAll<HTMLDivElement>('.room-grid').forEach(grid => {
            grid.classList.remove('drag-grid-visible');
        });
    }

    function getActiveFurnitureType():FurnitureType|null {
        if (selectedPlacedId !== null) {
            const item = items.find(x => x.id === selectedPlacedId);
            return item?.type || null;
        }
        return selectedFurniture?.type || null;
    }

    function showGridHover(target:{room:string;col:number;row:number}|null, type:FurnitureType|null = null) {
        clearGridHover();
        if (!target) return;
        const grid = getRoomGrid(target.room);
        if (!grid) return;
        grid.style.setProperty('--hover-col', String(target.col));
        grid.style.setProperty('--hover-row', String(target.row));
        if (type) {
            const f = FOOTPRINTS[type];
            grid.style.setProperty('--hover-cols', String(f.cols));
            grid.style.setProperty('--hover-rows', String(f.rows));
            grid.classList.add('footprint-preview');
            if (!isFootprintValid(target.room,type,target.col,target.row)) {
                grid.classList.add('footprint-invalid');
            }
        }
        grid.classList.add('grid-hovering');
    }

    function updateGridHover(clientX:number, clientY:number) {
        // Mouse coordinate is independent from furniture selection.
        // Normal room hover reveals only the room currently under the pointer.
        if (selectedPlacedId === null) hideAllRoomGrids();
        // Always show the raw cell under the pointer for this room.
        const room = roomAtPoint(clientX, clientY);
        if (!room) {
            clearGridHover();
            return null;
        }

        const raw = rawGridCell(clientX, clientY, room);
        if (!raw) {
            clearGridHover();
            return null;
        }

        showMouseGridCoord(room, raw.col, raw.row);

        // The visual placement hover is only needed when an object is selected.
        const type = getActiveFurnitureType();
        if (type) {
            const target = pointToGrid(clientX, clientY, room, type);
            showGridHover(target, type);
            return target;
        }

        // Still highlight the exact mouse cell for debugging/mapping.
        clearGridHover();
        const grid = getRoomGrid(room);
        if (grid) {
            grid.style.setProperty('--hover-col', String(raw.col));
            grid.style.setProperty('--hover-row', String(raw.row));
            grid.classList.add('grid-hovering');
        }
        return { room, ...raw };
    }

    /**
     * THE ONLY COMMIT FUNCTION.
     * Once this runs, the item's position is locked to the selected room tile
     * and integer room-specific grid coordinate. Pixel coordinates are never persisted.
     */
    function moveItemToGrid(item:PlacedItem, room:string, col:number, row:number) {
        const pos = findValidOrigin(room,item.type,col,row);
        if (!pos) return false;
        item.room = room;
        item.col = pos.col;
        item.row = pos.row;
        return true;
    }

    function applyGridPosition(element:HTMLImageElement, item:PlacedItem, grid:HTMLDivElement) {
        const f = FOOTPRINTS[item.type];
        const boardRect = board.getBoundingClientRect();
        const roomRect = grid.getBoundingClientRect();
        const cellW = roomRect.width / getGridCols(item.room);
        const cellH = roomRect.height / getGridRows(item.room);

        // Furniture is rendered in #placed-items (a sibling of the room grids).
        // The room grid is ONLY the coordinate plane. The stored room + col + row
        // are converted here into board-relative pixels.
        element.style.position = 'absolute';
        element.style.left = `${(roomRect.left - boardRect.left) + item.col * cellW}px`;
        element.style.top = `${(roomRect.top - boardRect.top) + item.row * cellH}px`;
        element.style.width = `${f.cols * cellW}px`;
        element.style.height = `${f.rows * cellH}px`;
        element.dataset.gridRoom = item.room;
        element.dataset.gridCol = String(item.col);
        element.dataset.gridRow = String(item.row);
    }

    function getItemElement(id:number) {
        return document.querySelector<HTMLImageElement>(`.placed-item[data-item-id="${id}"]`);
    }

    function updateThumbnailSize() {
        const widths = ROOM_IDS.map(id => getRoomGrid(id)?.getBoundingClientRect().width || 0).filter(Boolean);
        const roomWidth = Math.min(...widths);
        if (!roomWidth || !Number.isFinite(roomWidth)) return;
        document.documentElement.style.setProperty("--thumb-size", `${Math.max(30, Math.min(52, roomWidth * 0.05))}px`);
        renderItems();
    }

    function clearSelections() {
        document.querySelectorAll(".asset-card").forEach(c => c.classList.remove("selected"));
        document.querySelectorAll(".placed-item").forEach(c => c.classList.remove("selected"));
    }

    function selectInventory(src:string, type:FurnitureType, card:HTMLButtonElement) {
        selectedFurniture = { src, type };
        selectedPlacedId = null;
        clearSelections();
        card.classList.add("selected");
    }

    function selectPlaced(id:number) {
        const item = items.find(x => x.id === id);
        if (!item) return;
        selectedPlacedId = id;
        selectedFurniture = null;
        clearSelections();
        getItemElement(id)?.classList.add("selected");
    }

    function placeFurnitureAt(room:string, col:number, row:number) {
        if (selectedPlacedId !== null) {
            const item = items.find(x => x.id === selectedPlacedId);
            if (!item) return;
            const moved = moveItemToGrid(item, room, col, row);
            if (moved) playSound(soundPlace);
            selectedPlacedId = null;
            selectedFurniture = null;
            clearSelections();
            renderItems();
            return;
        }

        if (!selectedFurniture) return;
        const pos = findValidOrigin(room, selectedFurniture.type, col, row);
        if (!pos) return;
        const item:PlacedItem = {
            id:nextId++, src:selectedFurniture.src, type:selectedFurniture.type,
            room, col:pos.col, row:pos.row
        };
        items = [...items, item];
        playSound(soundPlace);
        // IMPORTANT: keep selectedFurniture active after placement.
        // One click in the tray arms the furniture type; every subsequent
        // grid click creates another independent copy until another asset
        // or a placed object is selected.
        selectedPlacedId = null;
        clearSelections();
        document.querySelectorAll<HTMLButtonElement>('.asset-card').forEach(card => {
            if (card.dataset.src === selectedFurniture?.src && card.dataset.type === selectedFurniture?.type) {
                card.classList.add('selected');
            }
        });
        renderItems();
    }

    function renderItems() {
        placedItems.replaceChildren();
        document.querySelectorAll<HTMLDivElement>('.origin-marker').forEach(el => el.remove());

        // Render from the GRID MODEL only. The house image is visual reference;
        // room-grid is the calibrated coordinate plane used for placement.
        for (const item of items) {
            const grid = getRoomGrid(item.room);
            if (!grid) continue;

            const img = document.createElement('img');
            img.className = 'placed-item';
            img.dataset.itemId = String(item.id);
            img.src = item.src;
            img.alt = item.type;
            img.draggable = false;
            applyGridPosition(img, item, grid);

            // Explicitly lock geometry on every render. The image must never be
            // allowed to fall back to its intrinsic PNG size during/after drag.
            img.style.position = 'absolute';

            // Explicit stacking: rug below bed. Overlap is allowed.
            img.style.zIndex = item.type === "rug" ? "50" : (item.type === "bed" ? "70" : "60");
            img.style.pointerEvents = 'auto';

            const originMarker = document.createElement('div');
            originMarker.className = 'origin-marker';
            originMarker.dataset.itemId = String(item.id);
            originMarker.dataset.gridCol = String(item.col);
            originMarker.dataset.gridRow = String(item.row);
            const originCols = getGridCols(item.room);
            const originRows = getGridRows(item.room);
            originMarker.style.left = `${item.col * 100 / originCols}%`;
            originMarker.style.top = `${item.row * 100 / originRows}%`;
            originMarker.style.width = `${100 / originCols}%`;
            originMarker.style.height = `${100 / originRows}%`;
            grid.appendChild(originMarker);

            let dragging = false;
            let suppressClick = false;
            let dragPointerId:number|null = null;
            let lastTarget:{room:string;col:number;row:number}|null = null;
            let startX = 0;
            let startY = 0;

            // Screen -> calibrated room -> room-specific grid cell.
            // This is the same coordinate model used by the mouse readout,
            // so the cell shown in the purple panel is the cell used for commit.
            const getDragTarget = (clientX:number, clientY:number) => {
                const room = roomAtPoint(clientX, clientY);
                if (!room) return null;
                const raw = rawGridCell(clientX, clientY, room);
                if (!raw) return null;
                const pos = findValidOrigin(room,item.type,raw.col,raw.row);
                return pos ? { room, ...pos } : null;
            };

            const cleanupDragStyles = () => {
                // IMPORTANT: never clear the geometry inline styles here.
                // The furniture is already rendered with an explicit board-relative
                // left/top/width/height matching its grid footprint. Clearing those
                // styles makes the <img> fall back to its intrinsic PNG dimensions,
                // which is exactly what caused the huge "zoom" on drag.
                img.classList.remove('dragging');
                img.style.position = 'absolute';
                img.style.zIndex = item.type === "rug" ? "50" : (item.type === "bed" ? "70" : "60");
                img.style.pointerEvents = 'auto';
                img.style.opacity = '';
            };

            const finishDrag = (event:PointerEvent) => {
                if (dragPointerId !== event.pointerId) return;

                window.removeEventListener('pointermove', onMove);
                window.removeEventListener('pointerup', onUp);
                window.removeEventListener('pointercancel', onUp);

                // The release cell is converted using the exact same calibrated
                // room/grid mapping as hover. If release happens just outside,
                // keep the last valid grid cell rather than reverting.
                const releaseTarget = getDragTarget(event.clientX, event.clientY);
                const releaseRoom = roomAtPoint(event.clientX,event.clientY);

                if (dragging) {
                    if (releaseTarget) {
                        // Move the existing item. Never create a second item.
                        const moved = moveItemToGrid(item, releaseTarget.room, releaseTarget.col, releaseTarget.row);
                        if (moved) playSound(soundPlace);
                    } else if (!releaseRoom) {
                        // Drag completely outside all rooms = delete this existing item.
                        items = items.filter(x => x.id !== item.id);
                        playSound(soundDelete);
                    } else if (lastTarget) {
                        // Invalid door/wall area: keep the last valid placement.
                        moveItemToGrid(item,lastTarget.room,lastTarget.col,lastTarget.row);
                    }
                }

                try {
                    if (img.hasPointerCapture(event.pointerId)) img.releasePointerCapture(event.pointerId);
                } catch (_) {}

                dragPointerId = null;
                lastTarget = null;
                selectedPlacedId = null;
                selectedFurniture = null;
                clearSelections();
                cleanupDragStyles();
                clearGridHover();
                hideAllRoomGrids();
                renderItems();
            };

            const onUp = (event:PointerEvent) => {
                finishDrag(event);
            };

            const onMove = (moveEvent:PointerEvent) => {
                if (dragPointerId !== moveEvent.pointerId) return;

                const distance = Math.hypot(moveEvent.clientX - startX, moveEvent.clientY - startY);
                if (!dragging && distance < 5) return;

                dragging = true;
                suppressClick = true;
                img.classList.add('dragging');
                // IMPORTANT: do NOT move/resize the real furniture element while
                // dragging. Its rendered size is already locked to the footprint.
                // Moving the <img> itself during pointermove caused the browser to
                // temporarily resolve its intrinsic image size, producing the huge
                // zoom/jump seen on the first drag. The real item stays visually
                // stable until pointerup; the red footprint preview shows the
                // destination cell/footprint.
                img.style.pointerEvents = 'none';
                img.style.opacity = '0.72';

                const target = getDragTarget(moveEvent.clientX, moveEvent.clientY);
                if (!target) {
                    // Outside all rooms: don't invent a coordinate.
                    // The last valid grid coordinate remains the commit candidate.
                    return;
                }

                lastTarget = target;

                // Keep the model untouched during the drag. Commit only on pointerup
                // so the furniture cannot visually jump while the pointer moves.
                showGridHover(target, item.type);
                const raw = rawGridCell(moveEvent.clientX, moveEvent.clientY, target.room);
                if (raw) showMouseGridCoord(target.room, raw.col, raw.row);
            };

            img.addEventListener('pointerdown', event => {
                event.preventDefault();
                event.stopPropagation();

                dragging = false;
                suppressClick = false;
                dragPointerId = event.pointerId;
                startX = event.clientX;
                startY = event.clientY;
                lastTarget = { room:item.room, col:item.col, row:item.row };

                selectPlaced(item.id);
                playSound(soundPickup);
                // As soon as furniture is picked up, reveal the room grid
                // so the user can see the available tile coordinates.
                showAllRoomGrids();

                // Pointer capture makes the drag/commit reliable even when the
                // furniture crosses room boundaries or leaves the original grid.
                try { img.setPointerCapture(event.pointerId); } catch (_) {}

                window.addEventListener('pointermove', onMove);
                window.addEventListener('pointerup', onUp);
                window.addEventListener('pointercancel', onUp);
            });

            img.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();
                if (suppressClick) { suppressClick = false; return; }
                selectPlaced(item.id);
            });

            placedItems.appendChild(img);
        }
    }

    document.querySelectorAll<HTMLButtonElement>(".asset-card").forEach(card => {
        card.addEventListener("click", event => {
            event.preventDefault();
            const src = card.dataset.src;
            const type = card.dataset.type as FurnitureType | undefined;
            if (!src || !type) return;
            playSound(soundClick);
            selectInventory(src, type, card);
        });
    });

    // CLICK-TO-MOVE / PLACE: board owns the commit. Furniture is a sibling
    // of the grids, so clicking a destination cannot be intercepted by the
    // source room's DOM tree. The hovered cell is always the furniture (0,0).
    board.addEventListener("pointerdown", event => {
        const targetElement = event.target as HTMLElement;
        if (targetElement.closest('.placed-item')) return;

        const type = getActiveFurnitureType();
        if (!type) return;

        const room = roomAtPoint(event.clientX, event.clientY);
        if (!room) {
            // Penempatan pertama di luar grid/ruangan = error.
            playSound(soundError);
            return;
        }

        const target = pointToGrid(event.clientX, event.clientY, room, type);
        if (!target) {
            playSound(soundError);
            return;
        }

        event.preventDefault();
        event.stopPropagation();
        placeFurnitureAt(target.room, target.col, target.row);
        clearGridHover();
    });

    document.querySelectorAll<HTMLDivElement>(".room-grid").forEach(grid => {
        grid.addEventListener("pointermove", event => {
            const room = grid.dataset.gridRoom;
            if (!room) return;
            const raw = rawGridCell(event.clientX, event.clientY, room);
            if (raw) showMouseGridCoord(room, raw.col, raw.row);
            updateGridHover(event.clientX, event.clientY);
        });
        grid.addEventListener("pointerleave", () => clearGridHover());
    });

    document.querySelectorAll<HTMLButtonElement>(".room-tab").forEach(tab => {
        tab.addEventListener("click", () => {
            const room = tab.dataset.room;
            if (!room) return;
            playSound(soundTab);
            document.querySelectorAll(".room-tab").forEach(button => {
                button.classList.remove("active");
                button.setAttribute("aria-selected", "false");
            });
            document.querySelectorAll(".room-content").forEach(content => content.classList.remove("active"));
            tab.classList.add("active");
            tab.setAttribute("aria-selected", "true");
            activeRoom = room;
            document.querySelector(`[data-content="${room}"]`)?.classList.add("active");
            updateThumbnailSize();
        });
    });

    async function captureHouse() {
        if (!board || !captureHouseButton) return;
        playSound(soundClick);

        const width = Math.max(1, Math.round(board.clientWidth));
        const height = Math.max(1, Math.round(board.clientHeight));
        const scale = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(width * scale);
        canvas.height = Math.round(height * scale);
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        ctx.setTransform(scale, 0, 0, scale, 0, 0);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";

        const boardRect = board.getBoundingClientRect();
        const images = Array.from(board.querySelectorAll<HTMLImageElement>("img.house-base, img.placed-item"))
            .sort((a, b) => (Number(getComputedStyle(a).zIndex) || 0) - (Number(getComputedStyle(b).zIndex) || 0));
        const loadImage = (img:HTMLImageElement) => new Promise<void>(resolve => {
            if (img.complete && img.naturalWidth > 0) { resolve(); return; }
            img.addEventListener("load", () => resolve(), { once:true });
            img.addEventListener("error", () => resolve(), { once:true });
        });
        await Promise.all(images.map(loadImage));

        // Draw exactly what is visible in the house board: base first, furniture on top.
        for (const img of images) {
            if (!img.naturalWidth || !img.naturalHeight) continue;
            const rect = img.getBoundingClientRect();
            ctx.drawImage(img, rect.left - boardRect.left, rect.top - boardRect.top, rect.width, rect.height);
        }

        const filename = `rumah-mimi-${new Date().toISOString().slice(0,10)}.png`;
        const blob = await new Promise<Blob|null>(resolve => canvas.toBlob(resolve, "image/png"));
        if (!blob) return;
        const file = new File([blob], filename, { type:"image/png" });

        try {
            // Smartphone: open the native Share sheet when file sharing is supported.
            if (navigator.share && (!navigator.canShare || navigator.canShare({ files:[file] }))) {
                await navigator.share({
                    title:"Rumah Mimi",
                    text:"Rumah Mimi yang sudah aku dekorasi 🏠✨",
                    files:[file]
                });
            } else {
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                link.href = url;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            }
        } catch (error) {
            if ((error as DOMException)?.name !== "AbortError") {
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                link.href = url;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            }
        }

        captureHouseButton.classList.add("captured");
        captureHouseButton.textContent = "✓ Tersimpan";
        setTimeout(() => {
            captureHouseButton.classList.remove("captured");
            captureHouseButton.textContent = "📷 Capture";
        }, 1600);
    }

    captureHouseButton?.addEventListener("click", captureHouse);

    startButton.addEventListener("click", () => {
        playSound(soundClick);
        intro.classList.add("hidden");
        resultScreen.classList.add("hidden");
        houseGame.classList.remove("hidden");
        updateThumbnailSize();
          startBackgroundMusic();
    });

    clearButton.addEventListener("click", () => {
        if (items.length) playSound(soundDelete);
        items = [];
        renderItems();
    });

    finishButton.addEventListener("click", () => {
        stopBackgroundMusic();
        houseGame.classList.add("hidden");
        resultScreen.innerHTML = `<div class="game-result-icon">🏠✨</div><h1>Rumah Mimi Selesai!</h1><p>Rumahmu sudah dihias. Keren banget!</p><div class="game-result-score">🪑 ${items.length} furniture ditempatkan</div><button class="start-game-button" id="decorate-again" type="button">🎨 Hias Lagi</button>`;
        resultScreen.classList.remove("hidden");
        document.getElementById("decorate-again")?.addEventListener("click", () => {
            resultScreen.classList.add("hidden");
            houseGame.classList.remove("hidden");
            updateThumbnailSize();
            startBackgroundMusic();
        });
    });

    window.addEventListener("mousemove", event => updateGridHover(event.clientX, event.clientY));
    window.addEventListener("mouseleave", clearGridHover);
    window.addEventListener("resize", updateThumbnailSize);
    new ResizeObserver(updateThumbnailSize).observe(board);
    updateThumbnailSize();

    function clampInt(v:number, min:number, max:number) {
        return Math.max(min, Math.min(max, Math.round(v)));
    }
</script>
